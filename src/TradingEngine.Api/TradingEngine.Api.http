// Local API walkthrough. Run requests top-to-bottom ("Run All Requests in
// File") against the API started locally in Rider (see
// docs/rider-local-azure-dev.md). Easy Auth does not exist locally, so these
// requests do not verify Azure authorization; the deployed checks live in
// TradingEngine.Api.Deployed.http.
//
// The registration request below is the start of a run: its pre-request
// script clears all stale walkthrough variables, generates a fresh runId plus
// a unique synthetic symbol RUN-<runId>-DEMO, and computes every date
// boundary relative to now so the ordering
//   now < applyUntil < boundedFrom < rescheduleFrom < boundedTo < openFrom
// always holds. Record the logged runId — the same value is needed by
// tools/Remove-TradingEngineTestRun.ps1 to delete the run's rows from the
// Azure Dev database afterwards.
//
// Requests guarded by a pre-request check abort with an error instead of
// writing when the previous step did not complete successfully: each
// dependent request requires the "walkthroughStep" left by its predecessor,
// and the token only advances when a response handler validates the
// expected status and payload, so a failed request - whether the response
// was wrong or never arrived - blocks every later dependent request even
// when ids and tokens from an earlier run are still present. The checks
// must not consume the token: Rider can evaluate a pre-request script more
// than once per request, so a clear inside the guard would remove the value
// before the request is actually sent.
@host = http://localhost:5068

GET {{host}}/health
Accept: application/json

###

GET {{host}}/version
Accept: application/json

###

// Start of a run: register the synthetic instrument. The instrument stays
// "configured" and is never monitored. The response handler captures the id
// only on the expected 201 so a failed registration cannot seed later writes.
< {%
    [
        "createdInstrumentId", "ruleToken", "coverageOrigin", "baseRevisionId",
        "draftId", "committedRevisionId", "committedEffectiveTo",
        "continuationRevisionId", "staleToken", "applyDraftId", "openDraftId",
        "openRevisionId", "deleteDraftId", "walkthroughStep"
    ].forEach(function (name) { client.global.clear(name); });

    var runId = (Date.now().toString(36)
        + Math.floor(Math.random() * 1296).toString(36)).toUpperCase();
    client.global.set("runId", runId);
    client.global.set("runSymbol", "RUN-" + runId + "-DEMO");
    client.global.set("applyUntil", new Date(Date.now() + 5 * 86400000).toISOString());
    client.global.set("boundedFrom", new Date(Date.now() + 10 * 86400000).toISOString());
    client.global.set("rescheduleFrom", new Date(Date.now() + 11 * 86400000).toISOString());
    client.global.set("boundedTo", new Date(Date.now() + 12 * 86400000).toISOString());
    client.global.set("openFrom", new Date(Date.now() + 30 * 86400000).toISOString());
%}
POST {{host}}/api/watched-instruments
Content-Type: application/json

{
  "symbol": "{{runSymbol}}",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": [
    {
      "id": "resistance-a",
      "lower": 120.0,
      "level": 125.0,
      "upper": 130.0,
      "conditions": [
        { "type": "breakout", "actionId": "publish-signal" }
      ]
    }
  ]
}

> {%
    client.test("registered", function() {
        client.assert(response.status === 201, "expected 201");
    });
    if (response.status === 201 && response.body && response.body.id) {
        client.global.set("createdInstrumentId", response.body.id);
        client.global.set("walkthroughStep", "registered");
        var runId = response.body.symbol.substring(4, response.body.symbol.length - 5);
        client.log("runId=" + runId
            + " - keep this value for cleanup: "
            + "tools/Remove-TradingEngineTestRun.ps1 -RunId " + runId + " -Apply");
    }
%}

###

// Read back the registration (point-in-time read, no lookup instant).
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    if (step !== "registered" || !createdInstrumentId || createdInstrumentId.trim() === "") {
        throw new Error("read-back requires a completed registration - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}
Accept: application/json

> {%
    client.test("read back", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(
            response.body.id === client.global.get("createdInstrumentId"),
            "returns the created instrument");
    });
    if (response.status === 200
        && response.body
        && response.body.id === client.global.get("createdInstrumentId")) {
        client.global.set("walkthroughStep", "read-back");
    }
%}

###

// Monitoring-rule revision walkthrough.
//
// Persisted timestamps must be exact 100 ns multiples; the generated ISO
// values carry only millisecond precision so this always holds. An omitted or
// JSON null bound means open-ended/unspecified, while a supplied blank or
// whitespace string is rejected 400 monitoring_rule.instant_invalid. The
// ?at= query keeps nanosecond precision for comparison.
// Actor: locally every write records "unverified-local-caller" (registration
// itself records "watched-instrument-registration"); the deployed API records
// the Easy Auth principal's object identifier instead.

// Timeline: committed revisions, coverage origin and the concurrency token
// (also returned as the ETag header). Capture the token, the origin and the
// base revision id for the walkthrough.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    if (step !== "read-back" || !createdInstrumentId || createdInstrumentId.trim() === "") {
        throw new Error("timeline requires the completed read-back - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule
Accept: application/json

> {%
    client.test("timeline", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.revisions.length === 1, "one revision");
    });
    if (response.status === 200
        && response.body
        && response.body.concurrencyToken
        && response.body.revisions
        && response.body.revisions.length === 1
        && response.body.revisions[0].id
        && response.body.coverageOrigin) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("coverageOrigin", response.body.coverageOrigin);
        client.global.set("baseRevisionId", response.body.revisions[0].id);
        client.global.set("walkthroughStep", "timeline");
    }
%}

###

// Historical/shared-boundary lookup: the origin instant selects the revision
// that starts there (boundaries are half-open, the successor wins). An
// instant before the origin would return 404 monitoring_rule.no_applicable_revision.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var coverageOrigin = client.global.get("coverageOrigin");
    if (step !== "timeline" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !coverageOrigin || coverageOrigin.trim() === "") {
        throw new Error("origin lookup requires the completed timeline read - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/applicable?at={{coverageOrigin}}
Accept: application/json

> {%
    client.test("origin lookup", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(
            response.body.revision.id === client.global.get("baseRevisionId"),
            "origin resolves the base revision");
    });
    if (response.status === 200
        && response.body
        && response.body.revision
        && response.body.revision.id === client.global.get("baseRevisionId")) {
        client.global.set("walkthroughStep", "origin-lookup");
    }
%}

###

// Drafts list for the same rule (empty initially).
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    if (step !== "origin-lookup" || !createdInstrumentId || createdInstrumentId.trim() === "") {
        throw new Error("drafts list requires the completed origin lookup - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

> {%
    var drafts = response.body ? response.body.drafts : null;
    var draftsEmpty = Array.isArray(drafts) && drafts.length === 0;
    client.test("drafts empty", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(draftsEmpty, "no drafts");
    });
    if (response.status === 200 && draftsEmpty) {
        client.global.set("walkthroughStep", "drafts-listed");
    }
%}

###

// Create a draft. Writes require If-Match with the latest concurrencyToken;
// missing -> 428, malformed -> 400, stale -> 412, and any rejection leaves
// the timeline, drafts and token unchanged.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    if (step !== "drafts-listed" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "") {
        throw new Error("draft creation requires the completed drafts list - run the file from the registration request.");
    }
%}
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "raise support",
  "proposedPeriod": { "effectiveFrom": "{{boundedFrom}}", "effectiveTo": "{{boundedTo}}" },
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 105.0,
        "level": 110.0,
        "upper": 115.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("draft created", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "draft-created");
    }
%}

###

// Read the drafts list to capture the draft id for the next requests.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    if (step !== "draft-created" || !createdInstrumentId || createdInstrumentId.trim() === "") {
        throw new Error("drafts list requires the completed draft creation - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

> {%
    client.test("one draft", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.drafts.length === 1, "one draft");
    });
    if (response.status === 200
        && response.body
        && response.body.drafts
        && response.body.drafts.length === 1
        && response.body.drafts[0].id) {
        client.global.set("draftId", response.body.drafts[0].id);
        client.global.set("walkthroughStep", "draft-listed");
    }
%}

###

// Edit the draft: replaces its definition, reason and proposal in one write.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var draftId = client.global.get("draftId");
    if (step !== "draft-listed" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "" || !draftId || draftId.trim() === "") {
        throw new Error("draft edit requires the completed draft creation - run the file from the registration request.");
    }
%}
PUT {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "raise support further",
  "proposedPeriod": { "effectiveFrom": "{{boundedFrom}}", "effectiveTo": "{{boundedTo}}" },
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 115.0,
        "level": 120.0,
        "upper": 125.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("draft edited", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "draft-edited");
    }
%}

###

// Bounded commit: schedule the draft over [boundedFrom, boundedTo) inside the
// open-ended tail. The response holds three committed revisions — the trimmed
// original keeping its id, the draft's revision, and a generated continuation
// revision carrying the original definition from boundedTo onward. A new GUID
// is needed here because the original revision retains two separated portions
// itself cannot hold; when only one boundary of a surviving revision moves,
// that revision keeps its GUID.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var draftId = client.global.get("draftId");
    if (step !== "draft-edited" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "" || !draftId || draftId.trim() === "") {
        throw new Error("scheduling requires the completed draft edit - run the file from the registration request.");
    }
%}
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}/schedule
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "effectiveFrom": "{{boundedFrom}}",
  "effectiveTo": "{{boundedTo}}"
}

> {%
    client.test("bounded schedule", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.revisions.length === 3, "three revisions");
    });
    if (response.status === 200
        && response.body
        && response.body.concurrencyToken
        && response.body.revisions
        && response.body.revisions.length === 3
        && response.body.revisions[1].id
        && response.body.revisions[1].effectiveTo
        && response.body.revisions[2].id) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("committedRevisionId", response.body.revisions[1].id);
        client.global.set("committedEffectiveTo", response.body.revisions[1].effectiveTo);
        client.global.set("continuationRevisionId", response.body.revisions[2].id);
        client.global.set("walkthroughStep", "bounded-scheduled");
    }
%}

###

// Read the generated continuation: a real committed row numbered 3 with the
// original definition, created at the commit instant and inheriting its
// createdBy from the original draft's creator.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var continuationRevisionId = client.global.get("continuationRevisionId");
    if (step !== "bounded-scheduled" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !continuationRevisionId || continuationRevisionId.trim() === "") {
        throw new Error("continuation read requires the completed schedule - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{continuationRevisionId}}
Accept: application/json

> {%
    client.test("continuation", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.revision.id === client.global.get("continuationRevisionId"), "id");
        client.assert(
            response.body.revision.effectiveFrom === client.global.get("committedEffectiveTo"),
            "starts where the scheduled revision ends");
    });
    if (response.status === 200
        && response.body
        && response.body.revision
        && response.body.revision.id === client.global.get("continuationRevisionId")
        && response.body.revision.effectiveFrom === client.global.get("committedEffectiveTo")) {
        client.global.set("walkthroughStep", "continuation-read");
    }
%}

###

// Shared-boundary lookup: at exactly boundedFrom the scheduled revision wins;
// one nanosecond earlier the predecessor applies (nanosecond precision is
// honoured for comparison-only instants).
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var committedRevisionId = client.global.get("committedRevisionId");
    if (step !== "continuation-read" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !committedRevisionId || committedRevisionId.trim() === "") {
        throw new Error("boundary lookup requires the completed continuation read - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/applicable?at={{boundedFrom}}
Accept: application/json

> {%
    client.test("boundary successor", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(
            response.body.revision.id === client.global.get("committedRevisionId"),
            "boundary selects the successor");
    });
    if (response.status === 200
        && response.body
        && response.body.revision
        && response.body.revision.id === client.global.get("committedRevisionId")) {
        client.global.set("walkthroughStep", "boundary-lookup");
    }
%}

###

// Create a second draft, then apply it from server now until applyUntil in a
// single write — no need to know the server's clock. applyUntil is before
// boundedFrom, so the scheduled plan is untouched; a new continuation is
// generated for [applyUntil, boundedFrom).
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    if (step !== "boundary-lookup" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "") {
        throw new Error("second draft requires the completed boundary lookup - run the file from the registration request.");
    }
%}
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "temporary tightening",
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 125.0,
        "level": 130.0,
        "upper": 135.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("second draft", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "second-draft");
    }
%}

###

< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    if (step !== "second-draft" || !createdInstrumentId || createdInstrumentId.trim() === "") {
        throw new Error("drafts list requires the completed second draft - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

> {%
    client.test("one pending draft", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.drafts.length === 1, "one draft");
    });
    if (response.status === 200
        && response.body
        && response.body.drafts
        && response.body.drafts.length === 1
        && response.body.drafts[0].id) {
        client.global.set("applyDraftId", response.body.drafts[0].id);
        client.global.set("walkthroughStep", "apply-draft-listed");
    }
%}

###

// Bounded apply-from-now. The pre-request script captures the token that is
// valid right now so the stale-token replay below can prove rejection.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var applyDraftId = client.global.get("applyDraftId");
    if (step !== "apply-draft-listed" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "" || !applyDraftId || applyDraftId.trim() === "") {
        throw new Error("apply requires the completed drafts list - run the file from the registration request.");
    }
    client.global.set("staleToken", ruleToken);
%}
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{applyDraftId}}/apply
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "effectiveTo": "{{applyUntil}}"
}

> {%
    client.test("bounded apply", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.revisions.length === 5, "five revisions");
    });
    if (response.status === 200
        && response.body
        && response.body.concurrencyToken
        && response.body.revisions
        && response.body.revisions.length === 5) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "apply-bounded");
    }
%}

###

// Deliberately expected failure: replay the stale token captured before the
// apply. Expect 412 monitoring_rule.concurrent_change with the timeline
// untouched. The token is deliberately NOT updated from this error response.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var staleToken = client.global.get("staleToken");
    if (step !== "apply-bounded" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !staleToken || staleToken.trim() === "") {
        throw new Error("stale-token check requires the completed apply - run the file from the registration request.");
    }
%}
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{staleToken}}"

{
  "changeReason": "stale write",
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 135.0,
        "level": 140.0,
        "upper": 145.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("stale rejected", function() {
        client.assert(response.status === 412, "expected 412");
        client.assert(response.body.code === "monitoring_rule.concurrent_change", "code");
    });
    if (response.status === 412
        && response.body
        && response.body.code === "monitoring_rule.concurrent_change") {
        client.global.set("walkthroughStep", "stale-verified");
    }
%}

###

// Amend the surviving scheduled revision: move its start to rescheduleFrom
// (at least one of definition/effectiveFrom required; an invalid combined
// amendment would change nothing).
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var committedRevisionId = client.global.get("committedRevisionId");
    if (step !== "stale-verified" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === ""
        || !committedRevisionId || committedRevisionId.trim() === "") {
        throw new Error("amendment requires the completed stale-token check - run the file from the registration request.");
    }
%}
PUT {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{committedRevisionId}}
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "fine tune",
  "effectiveFrom": "{{rescheduleFrom}}"
}

> {%
    client.test("amend", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "amended");
    }
%}

###

// Open-ended replacement: schedule a fresh draft from openFrom with
// "effectiveTo": null (omitted or null means open-ended — a blank string
// would be rejected). The existing continuation survives as
// [boundedTo, openFrom) keeping its continuationRevisionId; the new revision
// owns [openFrom, infinity).
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    if (step !== "amended" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "") {
        throw new Error("third draft requires the completed amendment - run the file from the registration request.");
    }
%}
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "long-term plan",
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 140.0,
        "level": 145.0,
        "upper": 150.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("third draft", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "third-draft");
    }
%}

###

< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    if (step !== "third-draft" || !createdInstrumentId || createdInstrumentId.trim() === "") {
        throw new Error("drafts list requires the completed third draft - run the file from the registration request.");
    }
%}
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

> {%
    client.test("one pending draft", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.drafts.length === 1, "one draft");
    });
    if (response.status === 200
        && response.body
        && response.body.drafts
        && response.body.drafts.length === 1
        && response.body.drafts[0].id) {
        client.global.set("openDraftId", response.body.drafts[0].id);
        client.global.set("walkthroughStep", "open-draft-listed");
    }
%}

###

< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var openDraftId = client.global.get("openDraftId");
    if (step !== "open-draft-listed" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "" || !openDraftId || openDraftId.trim() === "") {
        throw new Error("open-ended schedule requires the completed drafts list - run the file from the registration request.");
    }
%}
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{openDraftId}}/schedule
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "effectiveFrom": "{{openFrom}}",
  "effectiveTo": null
}

> {%
    client.test("open-ended schedule", function() {
        client.assert(response.status === 200, "expected 200");
        var revisions = response.body.revisions;
        client.assert(revisions[revisions.length - 1].effectiveTo === null, "open-ended tail");
    });
    if (response.status === 200
        && response.body
        && response.body.concurrencyToken
        && response.body.revisions
        && response.body.revisions.length > 0
        && response.body.revisions[response.body.revisions.length - 1].effectiveTo === null
        && response.body.revisions[response.body.revisions.length - 1].id) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        var tail = response.body.revisions;
        client.global.set("openRevisionId", tail[tail.length - 1].id);
        client.global.set("walkthroughStep", "open-scheduled");
    }
%}

###

// Remove the rescheduled committed revision; its predecessor's end reopens to
// boundedTo. (committedRevisionId survived every earlier write because the
// bounded apply ended at applyUntil, before boundedFrom.)
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var committedRevisionId = client.global.get("committedRevisionId");
    if (step !== "open-scheduled" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === ""
        || !committedRevisionId || committedRevisionId.trim() === "") {
        throw new Error("revision removal requires the completed open-ended schedule - run the file from the registration request.");
    }
%}
DELETE {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{committedRevisionId}}
If-Match: "{{ruleToken}}"

> {%
    client.test("remove revision", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "revision-removed");
    }
%}

###

// Discard a draft: create one more so the DELETE targets a live draft id.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    if (step !== "revision-removed" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "") {
        throw new Error("fourth draft requires the completed revision removal - run the file from the registration request.");
    }
%}
