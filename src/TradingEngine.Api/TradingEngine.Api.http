@host = http://localhost:5068

GET {{host}}/health
Accept: application/json

###

GET {{host}}/version
Accept: application/json

###

// Deployed API (Easy Auth). Define deployedHost, bearerToken and databaseProbeKey
// in http-client.private.env.json next to this file; that file is gitignored.
// See docs/easy-auth-entra-id.md for how to obtain a token as the owner.
//
// http-client.private.env.json example:
// {
//   "dev": {
//     "deployedHost": "https://<web-app-default-hostname>",
//     "bearerToken": "<API access token from an approved client application>",
//     "databaseProbeKey": "<probe key>"
//   }
// }

// Anonymous smoke-test endpoints: expect 200 without any token.
GET {{deployedHost}}/health
Accept: application/json

###

GET {{deployedHost}}/version
Accept: application/json

###

// Anonymous request to the protected API check: expect 401 from Easy Auth.
GET {{deployedHost}}/auth-check
Accept: application/json

###

// Owner request to the protected API check: expect 204 with no body.
GET {{deployedHost}}/auth-check
Accept: application/json
Authorization: Bearer {{bearerToken}}

###

// Database readiness probe: anonymous by policy but gated by the probe key.
// Without the header expect 404; with it expect 200 and {"status":"Healthy"}.
GET {{deployedHost}}/health/database
Accept: application/json
X-Database-Probe-Key: {{databaseProbeKey}}

###

// Local API: watched-instrument administration. Easy Auth does not exist
// locally, so these requests do not verify Azure authorization.
POST {{host}}/api/watched-instruments
Content-Type: application/json

{
  "symbol": "DEMO-2",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": [
    {
      "id": "resistance-a",
      "lower": 120.0,
      "level": 125.0,
      "upper": 130.0,
      "conditions": [
        { "type": "breakout", "actionId": "publish-signal" }
      ]
    }
  ]
}

> {%
    client.global.set("createdInstrumentId", response.body.id);
%}

###

// Replace the id with the value returned by the previous POST.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}
Accept: application/json

###

// Deployed API: anonymous administration request, expect 401 from Easy Auth.
POST {{deployedHost}}/api/watched-instruments
Content-Type: application/json

{
  "symbol": "DEMO-2",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": []
}

###

// Deployed API: authenticated owner request, expect 201 with a Location header.
POST {{deployedHost}}/api/watched-instruments
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "symbol": "DEMO-2",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": [
    {
      "id": "resistance-a",
      "lower": 120.0,
      "level": 125.0,
      "upper": 130.0,
      "conditions": [
        { "type": "breakout", "actionId": "publish-signal" }
      ]
    }
  ]
}

> {%
    client.global.set("createdInstrumentId", response.body.id);
%}

###

// Deployed API: authenticated owner read, expect 200; unknown ids return 404.
GET {{deployedHost}}/api/watched-instruments/{{createdInstrumentId}}
Accept: application/json
Authorization: Bearer {{bearerToken}}

###

// Monitoring-rule revision walkthrough (local API).
//
// Dates: every future boundary below uses these variables — move them forward
// before running so they stay ahead of server now. Persisted timestamps must
// be exact 100 ns multiples; the ?at= query keeps nanosecond precision.
// Actor: locally every write records "unverified-local-caller"; the deployed
// API records the Easy Auth principal's object identifier instead.
@boundedFrom = 2030-02-10T00:00:00Z
@boundedTo = 2030-02-12T00:00:00Z
@applyUntil = 2030-02-20T00:00:00Z

// Timeline: committed revisions, coverage origin and the concurrency token
// (also returned as the ETag header). Capture the token for writes.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule
Accept: application/json

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// Drafts list for the same rule.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

###

// Revision effective at an instant; omit ?at= to resolve at server now.
// Sub-tick values such as 2030-02-10T00:00:00.999999999Z are honoured here.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/applicable?at=2030-02-10T00:00:00Z
Accept: application/json

###

// Create a draft. Writes require If-Match with the latest concurrencyToken;
// missing -> 428, malformed -> 400, stale -> 412, and any rejection leaves
// the timeline, drafts and token unchanged.
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "raise support",
  "proposedPeriod": { "effectiveFrom": "{{boundedFrom}}", "effectiveTo": "{{boundedTo}}" },
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 105.0,
        "level": 110.0,
        "upper": 115.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// Read the drafts list to capture the draft id for the next requests.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

> {%
    client.global.set("draftId", response.body.drafts[0].id);
%}

###

// Edit the draft: replaces its definition, reason and proposal in one write.
PUT {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "raise support further",
  "proposedPeriod": { "effectiveFrom": "{{boundedFrom}}", "effectiveTo": "{{boundedTo}}" },
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 115.0,
        "level": 120.0,
        "upper": 125.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// Bounded-commit walkthrough: schedule the draft over [boundedFrom, boundedTo)
// inside the open-ended tail. The response contains three committed revisions —
// the trimmed original, the draft's revision and a generated continuation
// carrying the original definition from boundedTo onward. Capture both ids.
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}/schedule
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "effectiveFrom": "{{boundedFrom}}",
  "effectiveTo": "{{boundedTo}}"
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
    client.global.set("committedRevisionId", response.body.revisions[1].id);
    client.global.set("continuationRevisionId", response.body.revisions[2].id);
%}

###

// Read the generated continuation revision: a real committed row with the
// original definition, numbered 3, open-ended from boundedTo.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{continuationRevisionId}}
Accept: application/json

###

// Create a second draft, then apply it from server now until applyUntil in a
// single write — no need to know the server's clock.
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "temporary tightening",
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 125.0,
        "level": 130.0,
        "upper": 135.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

> {%
    client.global.set("applyDraftId", response.body.drafts[0].id);
%}

###

// Stale-token demonstration: keep a copy of the current token, perform a
// successful write, then replay the old token — expect 412
// monitoring_rule.concurrent_change with the timeline untouched.
> {%
    client.global.set("staleToken", client.global.get("ruleToken"));
%}

POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{applyDraftId}}/apply
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "effectiveTo": "{{applyUntil}}"
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// This replay uses the stale token captured before the apply: expect 412.
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{staleToken}}"

{
  "changeReason": "stale write",
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 135.0,
        "level": 140.0,
        "upper": 145.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

###

// After the bounded apply the timeline holds [origin -> now], [now ->
// applyUntil] and a generated continuation from applyUntil carrying whichever
// definition applied at applyUntil. Send the same apply body with no
// effectiveTo (or omit the body) for the open-ended apply instead.
PUT {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{committedRevisionId}}
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "fine tune",
  "effectiveFrom": "2030-02-11T00:00:00Z"
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// A revision amendment needs at least a definition or a new effectiveFrom;
// changeReason alone returns 400 revision.no_change_requested. An invalid
// combined amendment (for example a backdated start) changes nothing.
// Discard a draft, or remove a future revision (the predecessor reopens).
DELETE {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}
If-Match: "{{ruleToken}}"

###

DELETE {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{committedRevisionId}}
If-Match: "{{ruleToken}}"

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}
