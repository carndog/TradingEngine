###

< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var deleteDraftId = client.global.get("deleteDraftId");
    if (step !== "delete-draft-listed" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "" || !deleteDraftId || deleteDraftId.trim() === "") {
        throw new Error("draft deletion requires the completed drafts list - run the file from the registration request.");
    }
%}
DELETE {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{deleteDraftId}}
If-Match: "{{ruleToken}}"

> {%
    client.test("draft deleted", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "draft-deleted");
    }
%}

###

// Deletion restriction: the revision holding the coverage origin can never be
// rescheduled or removed. Here the origin revision has already begun - the
// coverage origin is the registration instant - so removal is rejected 409
// revision.period_begun with the timeline unchanged; a future-origin
// timeline would return revision.coverage_origin_protected instead. The
// token is deliberately not updated.
< {%
    var step = client.global.get("walkthroughStep");
    var createdInstrumentId = client.global.get("createdInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var baseRevisionId = client.global.get("baseRevisionId");
    if (step !== "draft-deleted" || !createdInstrumentId || createdInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === ""
        || !baseRevisionId || baseRevisionId.trim() === "") {
        throw new Error("origin-removal check requires the completed draft deletion - run the file from the registration request.");
    }
%}
DELETE {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{baseRevisionId}}
If-Match: "{{ruleToken}}"

> {%
    client.test("origin removal rejected", function() {
        client.assert(response.status === 409, "expected 409");
        client.assert(response.body.code === "revision.period_begun", "code");
    });
    if (response.status === 409
        && response.body
        && response.body.code === "revision.period_begun") {
        client.global.set("walkthroughStep", "origin-removal-rejected");
    }
%}
