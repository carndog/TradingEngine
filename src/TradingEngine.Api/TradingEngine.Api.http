@host = http://localhost:5068

GET {{host}}/health
Accept: application/json

###

GET {{host}}/version
Accept: application/json

###

// Deployed API (Easy Auth). Define deployedHost, bearerToken and databaseProbeKey
// in http-client.private.env.json next to this file; that file is gitignored.
// See docs/easy-auth-entra-id.md for how to obtain a token as the owner.
//
// http-client.private.env.json example:
// {
//   "dev": {
//     "deployedHost": "https://<web-app-default-hostname>",
//     "bearerToken": "<API access token from an approved client application>",
//     "databaseProbeKey": "<probe key>"
//   }
// }

// Anonymous smoke-test endpoints: expect 200 without any token.
GET {{deployedHost}}/health
Accept: application/json

###

GET {{deployedHost}}/version
Accept: application/json

###

// Anonymous request to the protected API check: expect 401 from Easy Auth.
GET {{deployedHost}}/auth-check
Accept: application/json

###

// Owner request to the protected API check: expect 204 with no body.
GET {{deployedHost}}/auth-check
Accept: application/json
Authorization: Bearer {{bearerToken}}

###

// Database readiness probe: anonymous by policy but gated by the probe key.
// Without the header expect 404; with it expect 200 and {"status":"Healthy"}.
GET {{deployedHost}}/health/database
Accept: application/json
X-Database-Probe-Key: {{databaseProbeKey}}

###

// Local API: watched-instrument administration. Easy Auth does not exist
// locally, so these requests do not verify Azure authorization.
POST {{host}}/api/watched-instruments
Content-Type: application/json

{
  "symbol": "DEMO-2",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": [
    {
      "id": "resistance-a",
      "lower": 120.0,
      "level": 125.0,
      "upper": 130.0,
      "conditions": [
        { "type": "breakout", "actionId": "publish-signal" }
      ]
    }
  ]
}

> {%
    client.global.set("createdInstrumentId", response.body.id);
%}

###

// Replace the id with the value returned by the previous POST.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}
Accept: application/json

###

// Deployed API: anonymous administration request, expect 401 from Easy Auth.
POST {{deployedHost}}/api/watched-instruments
Content-Type: application/json

{
  "symbol": "DEMO-2",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": []
}

###

// Deployed API: authenticated owner request, expect 201 with a Location header.
POST {{deployedHost}}/api/watched-instruments
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "symbol": "DEMO-2",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": [
    {
      "id": "resistance-a",
      "lower": 120.0,
      "level": 125.0,
      "upper": 130.0,
      "conditions": [
        { "type": "breakout", "actionId": "publish-signal" }
      ]
    }
  ]
}

> {%
    client.global.set("createdInstrumentId", response.body.id);
%}

###

// Deployed API: authenticated owner read, expect 200; unknown ids return 404.
GET {{deployedHost}}/api/watched-instruments/{{createdInstrumentId}}
Accept: application/json
Authorization: Bearer {{bearerToken}}

###

// Local API: monitoring-rule timeline. Committed revisions plus the coverage
// origin and the base64 concurrency token also returned as the ETag header.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule
Accept: application/json

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// Drafts list for the same rule.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Accept: application/json

###

// Revision effective at an instant; omit ?at= to resolve at server now.
GET {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/applicable?at=2026-10-06T10:00:00Z
Accept: application/json

###

// Create a draft. Writes require If-Match with the latest concurrencyToken;
// missing -> 428, malformed -> 400, stale -> 412.
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "raise support",
  "proposedPeriod": { "effectiveFrom": "2026-10-06T10:00:00Z", "effectiveTo": null },
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 105.0,
        "level": 110.0,
        "upper": 115.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": [
      {
        "id": "resistance-a",
        "lower": 120.0,
        "level": 125.0,
        "upper": 130.0,
        "conditions": [
          { "type": "breakout", "actionId": "publish-signal" }
        ]
      }
    ]
  }
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// Capture the draft id from GET .../drafts, then commit it open-ended from
// server now (apply) or over an explicit future range (schedule).
POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}/apply
If-Match: "{{ruleToken}}"

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

POST {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}/schedule
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "effectiveFrom": "2026-10-06T10:00:00Z",
  "effectiveTo": null
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// Edit a future scheduled revision: optional definition replacement and/or a
// new effectiveFrom boundary. Begun and origin revisions reject edits.
PUT {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{revisionId}}
Content-Type: application/json
If-Match: "{{ruleToken}}"

{
  "changeReason": "fine tune",
  "effectiveFrom": "2026-10-10T00:00:00Z"
}

> {%
    client.global.set("ruleToken", response.body.concurrencyToken);
%}

###

// Discard a draft, or remove a future revision (the predecessor reopens).
DELETE {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/drafts/{{draftId}}
If-Match: "{{ruleToken}}"

###

DELETE {{host}}/api/watched-instruments/{{createdInstrumentId}}/monitoring-rule/revisions/{{revisionId}}
If-Match: "{{ruleToken}}"
