{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "WindowSeconds": 60,
    "ReadPermitLimit": 120,
    "WritePermitLimit": 30,
    "ConcurrencyPermitLimit": 8,
    "QueueLimit": 0,
    "DatabaseProbePermitLimit": 10
  },
  "EToro": {
    "MarketData": {
      "BaseUrl": "https://public-api.etoro.com",
      "ExchangeMap": {},
      "QuoteCurrencyMap": {}
    }
  },
  "PriceCollection": {
    "Enabled": false,
    "PollIntervalSeconds": 15,
    "MaxExecutionTimeSeconds": 60,
    "UnavailableRetryAttempts": 1,
    "SamplingPolicy": "per-instrument",
    "ProviderRateLimit": 120,
    "ProviderWindowSeconds": 60,
    "ExchangeSessions": {
      "XNYS": {
        "TimeZone": "America/New_York",
        "Windows": [
          {
            "Days": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ],
            "Open": "09:30",
            "Close": "16:00"
          }
        ]
      }
    }
  }
}
