// Deployed API checks (Easy Auth). Run top-to-bottom against the deployed
// Web App. Define deployedHost, bearerToken and databaseProbeKey in
// http-client.private.env.json next to this file; that file is gitignored.
// See docs/easy-auth-entra-id.md for how to obtain a token as the owner.
// The local walkthrough lives in TradingEngine.Api.http and needs no token.
//
// http-client.private.env.json example:
// {
//   "dev": {
//     "deployedHost": "https://<web-app-default-hostname>",
//     "bearerToken": "<API access token from an approved client application>",
//     "databaseProbeKey": "<probe key>",
//     "principalObjectId": "<optional: owner Entra object id for actor checks>"
//   }
// }
//
// The anonymous registration below is where a run starts: its pre-request
// script clears stale variables and generates runId/runSymbol plus every
// date boundary exactly like the local file. Record the logged runId for
// tools/Remove-TradingEngineTestRun.ps1; deployed synthetic rows land in the
// same Azure Dev database and are removed by the same cleanup.
//
// Requests after the smoke checks run the #45 monitoring-rule lifecycle over
// the bearer token. A dependent request requires the "walkthroughStep" left
// by its predecessor and clears it before sending, so a failed step blocks
// every later request even when ids/tokens from an earlier run remain.
// When principalObjectId is configured the draft checks assert createdBy
// equals it; otherwise they only assert writes are attributed to a real
// caller rather than the unverified local fallback.

// Anonymous smoke-test endpoints: expect 200 without any token.
GET {{deployedHost}}/health
Accept: application/json

###

GET {{deployedHost}}/version
Accept: application/json

###

// Anonymous request to the protected API check: expect 401 from Easy Auth.
GET {{deployedHost}}/auth-check
Accept: application/json

> {%
    client.test("anonymous rejected", function() {
        client.assert(response.status === 401, "expected 401");
    });
%}

###

// Owner request to the protected API check: expect 204 with no body.
GET {{deployedHost}}/auth-check
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    client.test("owner accepted", function() {
        client.assert(response.status === 204, "expected 204");
    });
%}

###

// Database readiness probe: anonymous by policy but gated by the probe key.
// Without the header expect 404; with it expect 200 and {"status":"Healthy"}.
GET {{deployedHost}}/health/database
Accept: application/json
X-Database-Probe-Key: {{databaseProbeKey}}

> {%
    client.test("database healthy", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.status === "Healthy", "status");
    });
%}

###

// Start of a run: anonymous administration request, expect 401 from Easy
// Auth and no rows written. The generated symbol is used by the authenticated
// registration next; generating it here keeps even a misconfigured deployment
// from creating an unscoped instrument.
< {%
    [
        "deployedInstrumentId", "ruleToken", "coverageOrigin", "baseRevisionId",
        "draftId", "draftActor", "committedRevisionId", "committedEffectiveTo",
        "continuationRevisionId", "staleToken", "applyDraftId", "openDraftId",
        "openRevisionId", "deleteDraftId", "walkthroughStep"
    ].forEach(function (name) { client.global.clear(name); });

    var expectedActor = request.environment.get("principalObjectId");
    if (expectedActor && expectedActor.trim() !== "") {
        client.global.set("expectedActor", expectedActor.trim());
    } else {
        client.global.clear("expectedActor");
    }

    var runId = (Date.now().toString(36)
        + Math.floor(Math.random() * 1296).toString(36)).toUpperCase();
    client.global.set("runId", runId);
    client.global.set("runSymbol", "RUN-" + runId + "-DEMO");
    client.global.set("applyUntil", new Date(Date.now() + 5 * 86400000).toISOString());
    client.global.set("boundedFrom", new Date(Date.now() + 10 * 86400000).toISOString());
    client.global.set("rescheduleFrom", new Date(Date.now() + 11 * 86400000).toISOString());
    client.global.set("boundedTo", new Date(Date.now() + 12 * 86400000).toISOString());
    client.global.set("openFrom", new Date(Date.now() + 30 * 86400000).toISOString());
    client.log("runId=" + runId
        + " - keep this value for cleanup: "
        + "tools/Remove-TradingEngineTestRun.ps1 -RunId " + runId + " -Apply");
%}
POST {{deployedHost}}/api/watched-instruments
Content-Type: application/json

{
  "symbol": "{{runSymbol}}",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": []
}

> {%
    client.test("anonymous write rejected", function() {
        client.assert(response.status === 401, "expected 401");
    });
    if (response.status === 401) {
        client.global.set("walkthroughStep", "anonymous-write-rejected");
    }
%}

###

// Authenticated owner request, expect 201 with a Location header. The
// instrument stays "configured" and is never monitored; its RUN-<runId>-DEMO
// symbol marks it as synthetic for the cleanup script.
< {%
    var step = client.global.get("walkthroughStep");
    var runSymbol = client.global.get("runSymbol");
    var bearerToken = request.environment.get("bearerToken");
    if (step !== "anonymous-write-rejected" || !runSymbol || runSymbol.trim() === "") {
        throw new Error("registration requires the anonymous rejection above - run the file from the anonymous request.");
    }
    if (!bearerToken || bearerToken.trim() === "") {
        throw new Error("bearerToken is missing or blank in http-client.private.env.json - see docs/easy-auth-entra-id.md.");
    }
    client.global.clear("walkthroughStep");
%}
POST {{deployedHost}}/api/watched-instruments
Content-Type: application/json
Authorization: Bearer {{bearerToken}}

{
  "symbol": "{{runSymbol}}",
  "exchange": "XTEST",
  "quoteCurrency": "GBP",
  "samplingIntervalSeconds": 60,
  "monitoringState": "configured",
  "priceScale": 4,
  "supportZones": [
    {
      "id": "support-a",
      "lower": 95.0,
      "level": 100.0,
      "upper": 105.0,
      "conditions": [
        { "type": "buy-zone", "actionId": "publish-signal" },
        { "type": "support-loss", "actionId": "publish-signal" }
      ]
    }
  ],
  "resistanceZones": [
    {
      "id": "resistance-a",
      "lower": 120.0,
      "level": 125.0,
      "upper": 130.0,
      "conditions": [
        { "type": "breakout", "actionId": "publish-signal" }
      ]
    }
  ]
}

> {%
    client.test("registered", function() {
        client.assert(response.status === 201, "expected 201");
    });
    if (response.status === 201 && response.body && response.body.id) {
        client.global.set("deployedInstrumentId", response.body.id);
        client.global.set("walkthroughStep", "registered");
    }
%}

###

// Authenticated owner read, expect 200; unknown ids return 404.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    if (step !== "registered" || !deployedInstrumentId || deployedInstrumentId.trim() === "") {
        throw new Error("read-back requires the completed registration - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    client.test("read back", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.symbol === client.global.get("runSymbol"), "symbol");
    });
    if (response.status === 200
        && response.body
        && response.body.symbol === client.global.get("runSymbol")) {
        client.global.set("walkthroughStep", "read-back");
    }
%}

###

// Monitoring-rule revision lifecycle (issue #45), authenticated. Same
// sequence as TradingEngine.Api.http: persisted timestamps must be exact
// 100 ns multiples, an omitted or null bound is open-ended and a supplied
// blank bound is rejected 400. Writes record the Easy Auth principal's
// object identifier as createdBy; see the actor assertion on the drafts
// list after the first draft.

// Timeline: committed revisions, coverage origin and the concurrency token.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    if (step !== "read-back" || !deployedInstrumentId || deployedInstrumentId.trim() === "") {
        throw new Error("timeline requires the completed read-back - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    client.test("timeline", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.revisions.length === 1, "one revision");
    });
    if (response.status === 200
        && response.body
        && response.body.concurrencyToken
        && response.body.revisions
        && response.body.revisions.length === 1
        && response.body.revisions[0].id
        && response.body.coverageOrigin) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("coverageOrigin", response.body.coverageOrigin);
        client.global.set("baseRevisionId", response.body.revisions[0].id);
        client.global.set("walkthroughStep", "timeline");
    }
%}

###

// Historical/shared-boundary lookup: the origin instant selects the base
// revision (half-open boundaries, the successor wins).
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var coverageOrigin = client.global.get("coverageOrigin");
    if (step !== "timeline" || !deployedInstrumentId || deployedInstrumentId.trim() === ""
        || !coverageOrigin || coverageOrigin.trim() === "") {
        throw new Error("origin lookup requires the completed timeline read - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/revisions/applicable?at={{coverageOrigin}}
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    client.test("origin lookup", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(
            response.body.revision.id === client.global.get("baseRevisionId"),
            "origin resolves the base revision");
    });
    if (response.status === 200
        && response.body
        && response.body.revision
        && response.body.revision.id === client.global.get("baseRevisionId")) {
        client.global.set("walkthroughStep", "origin-lookup");
    }
%}

###

// Drafts list for the same rule (empty initially).
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    if (step !== "origin-lookup" || !deployedInstrumentId || deployedInstrumentId.trim() === "") {
        throw new Error("drafts list requires the completed origin lookup - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/drafts
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    var drafts = response.body ? response.body.drafts : null;
    var draftsEmpty = drafts !== null && drafts.length === 0;
    client.test("drafts empty", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(draftsEmpty, "no drafts");
    });
    if (response.status === 200 && draftsEmpty) {
        client.global.set("walkthroughStep", "drafts-listed");
    }
%}

###

// Create a draft. Writes require If-Match with the latest concurrencyToken;
// missing -> 428, malformed -> 400, stale -> 412.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    if (step !== "drafts-listed" || !deployedInstrumentId || deployedInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "") {
        throw new Error("draft creation requires the completed drafts list - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
POST {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"
Authorization: Bearer {{bearerToken}}

{
  "changeReason": "raise support",
  "proposedPeriod": { "effectiveFrom": "{{boundedFrom}}", "effectiveTo": "{{boundedTo}}" },
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 105.0,
        "level": 110.0,
        "upper": 115.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("draft created", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "draft-created");
    }
%}

###

// Read the drafts list: captures the draft id and verifies the authenticated
// actor. With principalObjectId configured, createdBy must equal it; without
// it, createdBy must be a real caller, not the unverified local fallback.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    if (step !== "draft-created" || !deployedInstrumentId || deployedInstrumentId.trim() === "") {
        throw new Error("drafts list requires the completed draft creation - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/drafts
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    var draft = response.body && response.body.drafts && response.body.drafts.length === 1
        ? response.body.drafts[0]
        : null;
    var draftIdOk = draft !== null
        && typeof draft.id === "string" && draft.id.trim() !== "";
    var createdBy = draft ? draft.createdBy : null;
    var expectedActor = client.global.get("expectedActor");
    var actorOk = typeof createdBy === "string" && createdBy.trim() !== ""
        && createdBy !== "unverified-local-caller"
        && createdBy !== "watched-instrument-registration"
        && (expectedActor === null || createdBy === expectedActor);
    client.log("draft createdBy=" + createdBy);
    client.test("one draft", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(draftIdOk, "one draft with a nonblank id");
    });
    client.test("authenticated actor", function() {
        if (expectedActor) {
            client.assert(actorOk, "createdBy is the caller principal object id");
        } else {
            client.assert(actorOk, "createdBy records the caller, not a local fallback");
        }
    });
    if (response.status === 200 && draftIdOk && actorOk) {
        client.global.set("draftId", draft.id);
        client.global.set("draftActor", draft.createdBy);
        client.global.set("walkthroughStep", "draft-listed");
    }
%}

###

// Edit the draft: replaces its definition, reason and proposal in one write.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var draftId = client.global.get("draftId");
    if (step !== "draft-listed" || !deployedInstrumentId || deployedInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "" || !draftId || draftId.trim() === "") {
        throw new Error("draft edit requires the completed drafts list - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
PUT {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/drafts/{{draftId}}
Content-Type: application/json
If-Match: "{{ruleToken}}"
Authorization: Bearer {{bearerToken}}

{
  "changeReason": "raise support further",
  "proposedPeriod": { "effectiveFrom": "{{boundedFrom}}", "effectiveTo": "{{boundedTo}}" },
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 115.0,
        "level": 120.0,
        "upper": 125.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("draft edited", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "draft-edited");
    }
%}

###

// Bounded commit: schedule the draft over [boundedFrom, boundedTo) inside
// the open-ended tail; the generated continuation keeps the original
// definition from boundedTo onward. The committed revision keeps the draft's
// createdBy, so it must equal the actor captured above.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    var draftId = client.global.get("draftId");
    if (step !== "draft-edited" || !deployedInstrumentId || deployedInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "" || !draftId || draftId.trim() === "") {
        throw new Error("scheduling requires the completed draft edit - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
POST {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/drafts/{{draftId}}/schedule
Content-Type: application/json
If-Match: "{{ruleToken}}"
Authorization: Bearer {{bearerToken}}

{
  "effectiveFrom": "{{boundedFrom}}",
  "effectiveTo": "{{boundedTo}}"
}

> {%
    var revisions = response.body && response.body.revisions && response.body.revisions.length === 3
        ? response.body.revisions
        : null;
    var committed = revisions ? revisions[1] : null;
    var committedIdOk = committed !== null
        && typeof committed.id === "string" && committed.id.trim() !== ""
        && !!committed.effectiveTo;
    var continuation = revisions ? revisions[2] : null;
    var continuationIdOk = continuation !== null
        && typeof continuation.id === "string" && continuation.id.trim() !== "";
    var actorOk = committed !== null
        && committed.createdBy === client.global.get("draftActor");
    client.test("bounded schedule", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(revisions !== null, "three revisions");
        client.assert(actorOk, "committed revision keeps the draft's creator");
    });
    if (response.status === 200
        && response.body
        && response.body.concurrencyToken
        && revisions !== null
        && committedIdOk
        && continuationIdOk
        && actorOk) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("committedRevisionId", committed.id);
        client.global.set("committedEffectiveTo", committed.effectiveTo);
        client.global.set("continuationRevisionId", continuation.id);
        client.global.set("walkthroughStep", "bounded-scheduled");
    }
%}

###

// Read the generated continuation: a committed row numbered 3 that starts
// where the scheduled revision ends and inherits the draft's creator.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var continuationRevisionId = client.global.get("continuationRevisionId");
    if (step !== "bounded-scheduled" || !deployedInstrumentId || deployedInstrumentId.trim() === ""
        || !continuationRevisionId || continuationRevisionId.trim() === "") {
        throw new Error("continuation read requires the completed schedule - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/revisions/{{continuationRevisionId}}
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    var revision = response.body && response.body.revision ? response.body.revision : null;
    var idOk = revision !== null
        && revision.id === client.global.get("continuationRevisionId");
    var fromOk = revision !== null
        && revision.effectiveFrom === client.global.get("committedEffectiveTo");
    var actorOk = revision !== null
        && revision.createdBy === client.global.get("draftActor");
    client.test("continuation", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(idOk, "id");
        client.assert(fromOk, "starts where the scheduled revision ends");
        client.assert(actorOk, "inherits the draft's creator");
    });
    if (response.status === 200 && idOk && fromOk && actorOk) {
        client.global.set("walkthroughStep", "continuation-read");
    }
%}

###

// Shared-boundary lookup: at exactly boundedFrom the scheduled revision wins.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var committedRevisionId = client.global.get("committedRevisionId");
    if (step !== "continuation-read" || !deployedInstrumentId || deployedInstrumentId.trim() === ""
        || !committedRevisionId || committedRevisionId.trim() === "") {
        throw new Error("boundary lookup requires the completed continuation read - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/revisions/applicable?at={{boundedFrom}}
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    client.test("boundary successor", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(
            response.body.revision.id === client.global.get("committedRevisionId"),
            "boundary selects the successor");
    });
    if (response.status === 200
        && response.body
        && response.body.revision
        && response.body.revision.id === client.global.get("committedRevisionId")) {
        client.global.set("walkthroughStep", "boundary-lookup");
    }
%}

###

// Create a second draft, then apply it from server now until applyUntil in a
// single write; a new continuation is generated for [applyUntil, boundedFrom).
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var ruleToken = client.global.get("ruleToken");
    if (step !== "boundary-lookup" || !deployedInstrumentId || deployedInstrumentId.trim() === ""
        || !ruleToken || ruleToken.trim() === "") {
        throw new Error("second draft requires the completed boundary lookup - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
POST {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/drafts
Content-Type: application/json
If-Match: "{{ruleToken}}"
Authorization: Bearer {{bearerToken}}

{
  "changeReason": "temporary tightening",
  "definition": {
    "priceScale": 4,
    "supportZones": [
      {
        "id": "support-a",
        "lower": 125.0,
        "level": 130.0,
        "upper": 135.0,
        "conditions": [
          { "type": "buy-zone", "actionId": "publish-signal" },
          { "type": "support-loss", "actionId": "publish-signal" }
        ]
      }
    ],
    "resistanceZones": []
  }
}

> {%
    client.test("second draft", function() {
        client.assert(response.status === 200, "expected 200");
    });
    if (response.status === 200 && response.body && response.body.concurrencyToken) {
        client.global.set("ruleToken", response.body.concurrencyToken);
        client.global.set("walkthroughStep", "second-draft");
    }
%}

###

< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    if (step !== "second-draft" || !deployedInstrumentId || deployedInstrumentId.trim() === "") {
        throw new Error("drafts list requires the completed second draft - run the file from the anonymous request.");
    }
    client.global.clear("walkthroughStep");
%}
GET {{deployedHost}}/api/watched-instruments/{{deployedInstrumentId}}/monitoring-rule/drafts
Accept: application/json
Authorization: Bearer {{bearerToken}}

> {%
    client.test("one pending draft", function() {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.drafts.length === 1, "one draft");
    });
    if (response.status === 200
        && response.body
        && response.body.drafts
        && response.body.drafts.length === 1
        && response.body.drafts[0].id) {
        client.global.set("applyDraftId", response.body.drafts[0].id);
        client.global.set("walkthroughStep", "apply-draft-listed");
    }
%}

###

// Bounded apply-from-now. The pre-request script captures the token that is
// valid right now so the stale-token replay below can prove rejection.
< {%
    var step = client.global.get("walkthroughStep");
    var deployedInstrumentId = client.global.get("deployedInstrumentId");
    var ruleToken = client.global.get("ruleToken");
