@inject TradingEngineApiClient Api
@inject NavigationManager Navigation
@inject SessionState SessionState
@implements IDisposable

@{
    SessionPresentation presentation = _presentation ?? SessionPresentation.Checking;
}
<div class="te-session" role="status" aria-live="polite" aria-label="Session">
    <span class="te-session-label">@presentation.Label</span>
    @if (presentation.SignInUrl is not null)
    {
        <a href="@presentation.SignInUrl">Sign in</a>
    }
    @if (presentation.SignOutUrl is not null)
    {
        <a href="@presentation.SignOutUrl">Sign out</a>
    }
    @if (presentation.CanRetry)
    {
        <button type="button" class="te-session-retry" @onclick="ReloadAsync">Retry</button>
    }
</div>

@code {
    private SessionPresentation? _presentation;
    private bool _checking;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        SessionState.Invalidated += OnSessionInvalidated;
        await ReloadAsync();
    }

    private void OnSessionInvalidated()
    {
        if (_disposed || _checking
            || _presentation?.Status is SessionStatus.Unauthorized or SessionStatus.Forbidden)
        {
            return;
        }

        _ = InvokeAsync(ReloadAndRenderAsync);
    }

    private async Task ReloadAndRenderAsync()
    {
        await ReloadAsync();
        if (_disposed is false)
        {
            StateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        if (_checking)
        {
            return;
        }

        _checking = true;
        try
        {
            ApiResult<SessionResponse> result = await Api.GetSessionAsync(_lifetime.Token);
            _presentation = SessionPresentation.From(result, AuthLinks.SignInUrl(Navigation));
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _checking = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        SessionState.Invalidated -= OnSessionInvalidated;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
