@inject TradingEngineApiClient Api

<section class="te-detail-card" aria-label="Instrument settings">
    <div class="te-row">
        <h3>Settings</h3>
        @if (_dirty)
        {
            <span class="te-tag te-dirty">Unsaved changes</span>
        }
    </div>
    <p class="te-note">Monitoring, sampling and price display for this instrument.</p>
    <ErrorNotice Error="@_saveError">
        <button type="button" @onclick="SaveAsync">Retry</button>
        @if (_saveError?.IsUnauthorized == true)
        {
            <a href="@SignInUrl">Sign in again</a>
        }
    </ErrorNotice>
    @if (_conflict.IsOpen)
    {
        <ConflictNotice Busy="@_busy"
                        OnDiscard="DiscardConflictAsync"
                        OnReapply="ReapplyConflictAsync">
            <LatestSummary>
                Server now shows @LatestStateLabel — last changed @UtcTimes.Format(_conflict.Latest?.LastChangedAt).
                Your input: @_editState · @_editInterval s · @_editDecimals dp · @_editUnit.
            </LatestSummary>
        </ConflictNotice>
    }
    <div class="te-fields te-two">
        <label>
            Monitoring state
            <select @bind="_editState" @bind:event="oninput" aria-label="Monitoring state">
                <option value="configured">Configured</option>
                <option value="monitored">Monitored</option>
            </select>
        </label>
        <label>
            Sampling interval (seconds)
            <input type="number" min="1" max="3600" @bind="_editInterval" @bind:event="oninput"
                   aria-label="Sampling interval seconds">
        </label>
        <label>
            Price decimal places
            <input type="number" min="0" max="8" step="1" @bind="_editDecimals" @bind:event="oninput"
                   aria-label="Price decimal places">
        </label>
        @if (_seeded is not null && PriceObservationFormat.HasMajorUnit(_seeded.QuoteCurrency))
        {
            <label>
                Display unit
                <select @bind="_editUnit" @bind:event="oninput" aria-label="Display unit">
                    <option value="major">@PriceObservationFormat.MajorUnitOf(_seeded.QuoteCurrency)</option>
                    <option value="native">@_seeded.QuoteCurrency (native)</option>
                </select>
            </label>
        }
    </div>
    <div class="te-footer">
        <button type="button" class="te-primary" @onclick="SaveAsync" disabled="@_busy">
            @(_busy ? "Saving…" : "Save settings")
        </button>
        @if (_dirty)
        {
            <button type="button" @onclick="DiscardLocalChanges" disabled="@_busy">Discard changes</button>
        }
    </div>
</section>

@if (_listing is ListingDto listing)
{
    <section class="te-detail-card" aria-label="Listing configuration">
        <h3>Listing</h3>
        <p class="te-note">Provider listing identity and the confirmed native quote unit used for price collection.</p>
        <ErrorNotice Error="@_listingError" />
        <div class="te-fields te-two">
            <div>
                <span class="te-note">Provider listing</span>
                <p>@ProviderListingSummary(listing)</p>
            </div>
            <div>
                <span class="te-note">Native quote unit</span>
                <p>@UnitSummary(listing)</p>
            </div>
        </div>
        @if (listing.UnitState is "unconfirmed" or "deployment")
        {
            <div class="te-fields te-two">
                <label>
                    Confirm native quote unit
                    <input @bind="_listingUnit" @bind:event="oninput" maxlength="10"
                           aria-label="Native quote unit to confirm"
                           placeholder="@(listing.NativeQuoteCurrency ?? "e.g. GBX")">
                </label>
            </div>
            <p class="te-note">Confirm the unit the provider quotes in — for example GBX for
                pence-priced listings. This is separate from the display unit above.</p>
            <div class="te-footer">
                <button type="button" class="te-primary" @onclick="ConfirmUnitAsync"
                        disabled="@(_busy || _listingBusy)">
                    @(_listingBusy ? "Confirming…" : "Confirm unit")
                </button>
            </div>
        }
        @if (listing.UnitState == "conflict")
        {
            <p class="te-alert te-warn" role="status">The persisted listing unit conflicts with the
                deployment-configured mapping. Reconcile the configuration before enabling collection.</p>
        }
    </section>
}

<DirtyGuard IsDirty="@(() => _dirty)" />

@code {
    private WatchedInstrumentSettingsResponse? _seeded;
    private ListingDto? _listing;
    private readonly ConflictResolution<WatchedInstrumentSettingsResponse> _conflict = new();
    private string _editState = "configured";
    private int _editInterval = 60;
    private int _editDecimals = 2;
    private string _editUnit = PriceObservationFormat.MajorDisplayUnit;
    private string _token = string.Empty;
    private bool _busy;
    private ApiError? _saveError;
    private string _listingUnit = string.Empty;
    private bool _listingBusy;
    private ApiError? _listingError;

    [Parameter, EditorRequired]
    public WatchedInstrumentSettingsResponse? Settings { get; set; }

    [Parameter]
    public string SignInUrl { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<WatchedInstrumentSettingsResponse> OnSaved { get; set; }

    [Parameter]
    public EventCallback<string> OnNotice { get; set; }

    [Parameter]
    public CancellationToken Cancellation { get; set; }

    private bool _dirty => _seeded is not null
        && (_editState != _seeded.MonitoringState
            || _editInterval != _seeded.SamplingIntervalSeconds
            || _editDecimals != _seeded.PriceDisplayDecimalPlaces
            || _editUnit != _seeded.PriceDisplayUnit);

    private string LatestStateLabel =>
        _conflict.Latest is null
            ? string.Empty
            : $"{_conflict.Latest.MonitoringState} · {_conflict.Latest.SamplingIntervalSeconds} s · {_conflict.Latest.PriceDisplayDecimalPlaces} dp · {_conflict.Latest.PriceDisplayUnit}";

    protected override void OnParametersSet()
    {
        if (Settings is not null
            && ReferenceEquals(Settings, _seeded) is false
            && _dirty is false
            && _conflict.IsOpen is false)
        {
            Seed(Settings);
        }
    }

    private void Seed(WatchedInstrumentSettingsResponse latest)
    {
        _seeded = latest;
        _listing = latest.Listing;
        _token = latest.ConcurrencyToken;
        _editState = latest.MonitoringState;
        _editInterval = latest.SamplingIntervalSeconds;
        _editDecimals = latest.PriceDisplayDecimalPlaces;
        _editUnit = latest.PriceDisplayUnit;
        _saveError = null;
        _listingError = null;
    }

    private void DiscardLocalChanges()
    {
        if (_seeded is not null)
        {
            _editState = _seeded.MonitoringState;
            _editInterval = _seeded.SamplingIntervalSeconds;
            _editDecimals = _seeded.PriceDisplayDecimalPlaces;
            _editUnit = _seeded.PriceDisplayUnit;
        }
    }

    private async Task SaveAsync()
    {
        if (_seeded is null)
        {
            return;
        }

        _busy = true;
        _saveError = null;
        _conflict.Take();

        ApiResult<WatchedInstrumentSettingsResponse> result;
        try
        {
            result = await Api.UpdateSettingsAsync(
                _seeded.Id,
                new UpdateWatchedInstrumentSettingsRequest(_editState, _editInterval, _editDecimals, _editUnit),
                _token,
                Cancellation);
        }
        finally
        {
            _busy = false;
        }

        if (result.IsSuccess)
        {
            Seed(result.Value!);
            await OnSaved.InvokeAsync(result.Value);
        }
        else if (result.Error!.IsPreconditionFailed)
        {
            await OpenConflictAsync();
        }
        else
        {
            _saveError = result.Error;
        }
    }

    private async Task OpenConflictAsync()
    {
        ApiResult<WatchedInstrumentSettingsResponse> latest =
            await Api.GetSettingsAsync(_seeded!.Id, Cancellation);
        if (latest.IsSuccess)
        {
            _conflict.Open(latest.Value!);
        }
        else
        {
            _saveError = latest.Error;
        }
    }

    private async Task DiscardConflictAsync()
    {
        WatchedInstrumentSettingsResponse latest = _conflict.Take();
        Seed(latest);
        await OnSaved.InvokeAsync(latest);
        await OnNotice.InvokeAsync("Latest settings loaded.");
    }

    private async Task ReapplyConflictAsync()
    {
        WatchedInstrumentSettingsResponse latest = _conflict.Take();
        _token = latest.ConcurrencyToken;
        await SaveAsync();
    }

    private async Task ConfirmUnitAsync()
    {
        if (_seeded is null || _listing is null)
        {
            return;
        }

        _listingBusy = true;
        _listingError = null;

        ApiResult<ListingDto> result;
        try
        {
            result = await Api.ConfirmListingUnitAsync(
                _seeded.Id,
                new ConfirmListingUnitRequest(
                    string.IsNullOrWhiteSpace(_listingUnit) ? null : _listingUnit),
                _listing.ConcurrencyToken,
                Cancellation);
        }
        finally
        {
            _listingBusy = false;
        }

        if (result.IsFailure)
        {
            _listingError = result.Error;
            return;
        }

        _listing = result.Value!;
        _listingUnit = string.Empty;

        if (_dirty)
        {
            await OnNotice.InvokeAsync("Listing unit confirmed.");
            return;
        }

        ApiResult<WatchedInstrumentSettingsResponse> latest =
            await Api.GetSettingsAsync(_seeded.Id, Cancellation);
        if (latest.IsFailure)
        {
            _listingError = latest.Error;
            return;
        }

        Seed(latest.Value!);
        await OnSaved.InvokeAsync(latest.Value);
        await OnNotice.InvokeAsync("Listing unit confirmed.");
    }

    private static string ProviderListingSummary(ListingDto listing)
    {
        if (listing.Provider is null)
        {
            return listing.ResolutionState switch
            {
                "not-found" => "No provider listing matched this exchange and symbol.",
                "ambiguous" => "The provider returned more than one matching listing.",
                "unsupported-venue" => "This exchange is not mapped to a provider venue.",
                "unavailable" => "The provider listing could not be verified.",
                _ => "Provider listing not resolved."
            };
        }

        string identity = listing.DisplayName is null
            ? $"{listing.Provider} instrument {listing.ProviderInstrumentId}"
            : $"{listing.Provider} · {listing.DisplayName} ({listing.ProviderInstrumentId})";
        return listing.ProviderExchangeName is null
            ? identity
            : $"{identity} on {listing.ProviderExchangeName}";
    }

    private static string UnitSummary(ListingDto listing)
    {
        return listing.UnitState switch
        {
            "confirmed" => $"{listing.NativeQuoteCurrency} — confirmed ({UnitSourceLabel(listing)})",
            "deployment" => $"{listing.NativeQuoteCurrency} — from deployment mapping",
            "conflict" => "Conflict between persisted and deployment-configured units",
            _ => "Not confirmed — required before monitoring can start"
        };
    }

    private static string UnitSourceLabel(ListingDto listing)
    {
        return listing.UnitSource == "provider-metadata" ? "provider metadata" : "administrator";
    }
}
