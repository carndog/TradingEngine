@inject IUiClock Clock

<section class="te-detail-card" aria-label="Draft revisions">
    <div class="te-row">
        <h3>Draft revisions</h3>
        <a class="te-primary" style="padding:8px 12px;border-radius:6px;text-decoration:none"
           href="instruments/@InstrumentId/drafts/new">+ New draft</a>
    </div>
    @if (Error is not null)
    {
        <ErrorNotice Error="@Error">
            <button type="button" @onclick="OnRetry">Retry</button>
            @if (Error.IsUnauthorized)
            {
                <a href="@SignInUrl">Sign in again</a>
            }
        </ErrorNotice>
    }
    else if (Drafts is null || Drafts.Drafts.Count == 0)
    {
        <p class="te-note" style="margin-top:12px">No drafts. Create one to prepare a configuration change.</p>
    }
    else
    {
        <ul class="te-history" style="margin-top:14px">
            @foreach (MonitoringRuleRevisionDto draft in Drafts.Drafts)
            {
                <li id="revision-@draft.Id" class="@(draft.Id == FocusId ? "te-focus" : null)" tabindex="-1">
                    <div class="te-row">
                        <div>
                            <strong>@RevisionLabels.DraftTitle(draft)</strong>
                            @if (draft.Id == FocusId)
                            {
                                <span class="te-badge te-current" style="margin-left:8px">Just changed</span>
                            }
                            <div class="te-small">
                                Created @UtcTimes.FormatWithSeconds(draft.CreatedAt) by <span title="@draft.CreatedBy">@ActorPresentation.Describe(draft)</span>
                            </div>
                            <div class="te-small">@RevisionLabels.DefinitionSummary(draft.Definition)</div>
                            @if (draft.ProposedEffectiveFrom is not null || draft.ProposedEffectiveTo is not null)
                            {
                                <div class="te-small">
                                    Proposal @UtcTimes.FormatRange(draft.ProposedEffectiveFrom, draft.ProposedEffectiveTo) (nonbinding)
                                    @if (ProposalIsPast(draft))
                                    {
                                        <span class="te-tag te-dirty" style="margin-left:8px">Proposed start has passed</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="te-inline-actions">
                            <a href="instruments/@InstrumentId/drafts/@draft.Id">Edit</a>
                            <button type="button" @onclick="() => OnApply.InvokeAsync(draft)">Apply now</button>
                            <button type="button" @onclick="() => OnSchedule.InvokeAsync(draft)">Schedule</button>
                            <button type="button" @onclick="() => OnDelete.InvokeAsync(draft)">Delete</button>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
    @ChildContent
</section>

@code {
    [Parameter]
    public MonitoringRuleDraftsResponse? Drafts { get; set; }

    [Parameter]
    public ApiError? Error { get; set; }

    [Parameter]
    public Guid InstrumentId { get; set; }

    [Parameter]
    public Guid? FocusId { get; set; }

    [Parameter]
    public string SignInUrl { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnRetry { get; set; }

    [Parameter]
    public EventCallback<MonitoringRuleRevisionDto> OnApply { get; set; }

    [Parameter]
    public EventCallback<MonitoringRuleRevisionDto> OnSchedule { get; set; }

    [Parameter]
    public EventCallback<MonitoringRuleRevisionDto> OnDelete { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool ProposalIsPast(MonitoringRuleRevisionDto draft)
    {
        return draft.ProposedEffectiveFrom is not null && draft.ProposedEffectiveFrom.Value < Clock.UtcNow;
    }
}
