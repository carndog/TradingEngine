<div class="te-body">
    <div>
        <span class="te-zone-head">Price scale</span>
        <p class="te-note">Decimal precision applied to every zone boundary (0–8).</p>
        <div class="te-fields" style="grid-template-columns:minmax(0,200px)">
            <label>
                <span class="te-sr">Price scale</span>
                <input type="number" min="0" max="8" @bind="Model.PriceScale" @bind:event="oninput" @bind:after="NotifyChanged">
            </label>
        </div>
    </div>

    <div>
        <div class="te-row">
            <span class="te-zone-head">Support zones</span>
            <button type="button" @onclick="AddSupport">+ Add support zone</button>
        </div>
        <p class="te-note">Each support zone requires a buy-zone and a support-loss condition.</p>
        @foreach (ZoneEditModel zone in Model.SupportZones)
        {
            <ZoneEditor Zone="@zone" OnChanged="NotifyChanged" OnRemove="() => RemoveSupport(zone)" />
        }
    </div>

    <div>
        <div class="te-row">
            <span class="te-zone-head">Resistance zones</span>
            <button type="button" @onclick="AddResistance">+ Add resistance zone</button>
        </div>
        <p class="te-note">Each resistance zone requires a breakout condition.</p>
        @foreach (ZoneEditModel zone in Model.ResistanceZones)
        {
            <ZoneEditor Zone="@zone" OnChanged="NotifyChanged" OnRemove="() => RemoveResistance(zone)" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DefinitionEditModel Model { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task AddSupport()
    {
        Model.AddSupportZone();
        await NotifyChanged();
    }

    private async Task AddResistance()
    {
        Model.AddResistanceZone();
        await NotifyChanged();
    }

    private async Task RemoveSupport(ZoneEditModel zone)
    {
        Model.SupportZones.Remove(zone);
        await NotifyChanged();
    }

    private async Task RemoveResistance(ZoneEditModel zone)
    {
        Model.ResistanceZones.Remove(zone);
        await NotifyChanged();
    }

    private Task NotifyChanged()
    {
        return OnChanged.InvokeAsync();
    }
}
