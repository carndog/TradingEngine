@page "/instruments/{Id:guid}/revisions/{RevisionId:guid}"
@inject TradingEngineApiClient Api
@inject NavigationManager Navigation
@inject IUiClock Clock
@inject IJSRuntime JS
@implements IDisposable

<div class="te-back">
    <a href="instruments/@Id?tab=timeline">← Back to timeline</a>
</div>

@if (_fatal is not null)
{
    <ErrorNotice Error="@_fatal">
        <button type="button" @onclick="LoadAsync">Retry</button>
        @if (_fatal.IsUnauthorized)
        {
            <a href="@SignInUrl">Sign in again</a>
        }
    </ErrorNotice>
}
else if (_loading)
{
    <div class="te-panel" role="status"><p class="te-sub">Loading…</p></div>
}
else
{
    <h2 tabindex="-1">Edit scheduled revision</h2>
    <p class="te-sub">@_instrumentLabel</p>

    <div class="te-editor">
        <div class="te-editor-head">
            <div class="te-row">
                <div>
                    <strong>Revision @(_revision?.RevisionNumber?.ToString() ?? string.Empty)</strong>
                    <p class="te-note">
                        Scheduled for @UtcTimes.Format(_revision?.EffectiveFrom)
                        @if (_revision?.EffectiveTo is not null)
                        {
                            <text> until @UtcTimes.Format(_revision.EffectiveTo)</text>
                        }
                    </p>
                </div>
                @if (Dirty)
                {
                    <span class="te-tag te-dirty">Unsaved changes</span>
                }
            </div>
        </div>
        <DefinitionEditor Model="@_definition" OnChanged="OnDefinitionChanged" />
    </div>

    <section class="te-detail-card" aria-label="Revision options">
        <h3>Options</h3>
        <div class="te-fields te-two">
            <label>
                Effective from (UTC)
                <input type="datetime-local" step="0.001" value="@_effectiveFrom.Text"
                       @onchange="args => _effectiveFrom.Set(args.Value?.ToString())"
                       aria-label="Effective from UTC">
            </label>
            @if (_effectiveFrom.HasSubMillisecondBaseline)
            {
                <p class="te-note">Stored value @_effectiveFrom.BaselinePreciseLabel — the picker edits to millisecond precision; leaving the field untouched keeps the stored value exactly.</p>
            }
            <label>
                Change reason
                <input @bind="_reason" @bind:event="oninput" maxlength="500"
                       aria-label="Change reason" placeholder="Why is this change being made?">
            </label>
        </div>
        <p class="te-note">
            Rescheduling requires a start at or after the current UTC time.
            Leave the start unchanged to keep the stored value exactly.
        </p>

        <ErrorNotice Error="@_saveError">
            @if (_saveError?.IsUnauthorized == true)
            {
                <a href="@SignInUrl">Sign in again</a>
            }
        </ErrorNotice>

        @if (_conflict.IsOpen)
        {
            <ConflictNotice Busy="@_busy"
                            OnDiscard="DiscardConflict"
                            OnReapply="ReapplyConflictAsync">
                <LatestSummary>
                    Latest revision: starts @UtcTimes.Format(_conflict.Latest?.Revision.EffectiveFrom),
                    reason '@(_conflict.Latest?.Revision.ChangeReason ?? "—")'; @_conflictDefinitionSummary.
                    Your input is kept — choose whether to adopt the latest version or reapply yours.
                </LatestSummary>
            </ConflictNotice>
        }

        <div class="te-footer">
            <button type="button" class="te-primary" @onclick="SaveAsync" disabled="@_busy">
                @(_busy ? "Saving…" : "Save revision")
            </button>
            <a href="instruments/@Id?tab=timeline" style="align-self:center">Cancel</a>
        </div>
    </section>
}

<DirtyGuard IsDirty="@(() => Dirty)" />

@code {
    private DefinitionEditModel _definition = DefinitionEditModel.Empty();
    private DefinitionEditModel _definitionBaseline = DefinitionEditModel.Empty();
    private MonitoringRuleRevisionDto? _revision;
    private ApiError? _fatal;
    private ApiError? _saveError;
    private bool _loading = true;
    private bool _busy;
    private string _instrumentLabel = string.Empty;
    private string _token = string.Empty;
    private string _reason = string.Empty;
    private string _reasonBaseline = string.Empty;
    private UtcTimeField _effectiveFrom = new(null);
    private readonly ConflictResolution<MonitoringRuleRevisionResponse> _conflict = new();
    private bool _headingFocusPending = true;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public Guid RevisionId { get; set; }

    private string SignInUrl => AuthLinks.SignInUrl(Navigation);

    private bool Dirty =>
        _definition.SameContent(_definitionBaseline) is false
        || _reason != _reasonBaseline
        || _effectiveFrom.Modified;

    private string _conflictDefinitionSummary
    {
        get
        {
            MonitoringRuleRevisionDto? latest = _conflict.Latest?.Revision;
            if (latest?.Definition is null)
            {
                return "no definition";
            }

            return DefinitionEditModel.FromDto(latest.Definition)
                .DescribeChangesAgainst(_definition);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_headingFocusPending && _loading is false && _fatal is null)
        {
            _headingFocusPending = false;
            await JS.InvokeVoidAsync("teFocus", "h2");
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _fatal = null;
        _saveError = null;
        _conflict.Take();

        ApiResult<WatchedInstrumentSettingsResponse> instrument =
            await Api.GetSettingsAsync(Id, _lifetime.Token);
        if (instrument.IsFailure)
        {
            _loading = false;
            _fatal = instrument.Error;
            return;
        }

        _instrumentLabel =
            $"{instrument.Value!.Symbol} · {instrument.Value.Exchange} · {instrument.Value.QuoteCurrency}";

        ApiResult<MonitoringRuleRevisionResponse> revision =
            await Api.GetRevisionAsync(Id, RevisionId, _lifetime.Token);
        if (revision.IsFailure)
        {
            _loading = false;
            _fatal = revision.Error;
            return;
        }

        if (Seed(revision.Value!) is false)
        {
            return;
        }

        _loading = false;
    }

    private bool Seed(MonitoringRuleRevisionResponse latest)
    {
        MonitoringRuleRevisionDto revision = latest.Revision;
        if (revision.EffectiveFrom is null || revision.EffectiveFrom <= Clock.UtcNow)
        {
            _fatal = ApiError.Create(409, "revision.period_begun",
                "This revision has already begun or ended and can no longer be edited.", null);
            _loading = false;
            return false;
        }

        _revision = revision;
        _token = latest.ConcurrencyToken;
        _definition = revision.Definition is null
            ? DefinitionEditModel.Empty()
            : DefinitionEditModel.FromDto(revision.Definition);
        _definitionBaseline = _definition.Clone();
        _reason = revision.ChangeReason ?? string.Empty;
        _reasonBaseline = _reason;
        _effectiveFrom.Reseed(revision.EffectiveFrom);
        return true;
    }

    private void OnDefinitionChanged()
    {
    }

    private void MarkSaved()
    {
        _definitionBaseline = _definition.Clone();
        _reasonBaseline = _reason;
        _effectiveFrom.AcceptResolved();
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _saveError = null;
        _conflict.Take();

        ApiResult<MonitoringRuleTimelineResponse>? result = null;
        try
        {
            ApiError? validationError = _effectiveFrom.RequestKeepUnchanged(out string? effectiveFromIso);
            if (validationError is not null)
            {
                _saveError = validationError;
                return;
            }

            EditMonitoringRuleRevisionRequest request = new(
                string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim(),
                _definition.ToDto(),
                effectiveFromIso);

            result = await Api.UpdateRevisionAsync(
                Id, RevisionId, request, _token, _lifetime.Token);
        }
        finally
        {
            _busy = false;
        }

        if (result!.IsSuccess)
        {
            MarkSaved();
            Navigation.NavigateTo($"instruments/{Id}?tab=timeline");
        }
        else if (result.Error!.IsPreconditionFailed)
        {
            await OpenConflictAsync();
        }
        else
        {
            _saveError = result.Error;
        }
    }

    private async Task OpenConflictAsync()
    {
        ApiResult<MonitoringRuleRevisionResponse> latest =
            await Api.GetRevisionAsync(Id, RevisionId, _lifetime.Token);
        if (latest.IsSuccess)
        {
            _conflict.Open(latest.Value!);
        }
        else
        {
            _saveError = latest.Error;
        }
    }

    private void DiscardConflict()
    {
        MonitoringRuleRevisionResponse latest = _conflict.Take();
        Seed(latest);
    }

    private async Task ReapplyConflictAsync()
    {
        MonitoringRuleRevisionResponse latest = _conflict.Take();
        _token = latest.ConcurrencyToken;
        await SaveAsync();
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
