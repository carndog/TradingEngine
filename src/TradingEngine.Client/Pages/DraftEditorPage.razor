@page "/instruments/{Id:guid}/drafts/new"
@page "/instruments/{Id:guid}/drafts/{DraftId:guid}"
@inject TradingEngineApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="te-back">
    <a href="instruments/@Id?tab=drafts">← Back to drafts</a>
</div>

@if (_fatal is not null)
{
    <ErrorNotice Error="@_fatal">
        <button type="button" @onclick="LoadAsync">Retry</button>
        @if (_fatal.IsUnauthorized)
        {
            <a href="@SignInUrl">Sign in again</a>
        }
    </ErrorNotice>
}
else if (_loading)
{
    <div class="te-panel" role="status"><p class="te-sub">Loading…</p></div>
}
else
{
    <h2 tabindex="-1">@(IsNew ? "New draft" : "Edit draft")</h2>
    <p class="te-sub">@_instrumentLabel</p>

    <div class="te-editor">
        <div class="te-editor-head">
            <div class="te-row">
                <div>
                    <strong>Draft definition</strong>
                    <p class="te-note">Drafts do not become effective until applied or scheduled.</p>
                </div>
                @if (Dirty)
                {
                    <span class="te-tag te-dirty">Unsaved changes</span>
                }
            </div>
        </div>
        <DefinitionEditor Model="@_definition" OnChanged="OnDefinitionChanged" />
    </div>

    <section class="te-detail-card" aria-label="Draft options">
        <h3>Options</h3>
        <div class="te-fields">
            <label>
                Proposed start (UTC, optional)
                <input type="datetime-local" step="0.001" value="@_proposedFrom.Text"
                       @onchange="args => _proposedFrom.Set(args.Value?.ToString())"
                       aria-label="Proposed effective from UTC">
            </label>
            <label>
                Proposed end (UTC, optional)
                <input type="datetime-local" step="0.001" value="@_proposedTo.Text"
                       @onchange="args => _proposedTo.Set(args.Value?.ToString())"
                       aria-label="Proposed effective to UTC">
            </label>
            @if (_proposedFrom.HasSubMillisecondBaseline || _proposedTo.HasSubMillisecondBaseline)
            {
                <p class="te-note">
                    Stored values @(_proposedFrom.HasSubMillisecondBaseline ? _proposedFrom.BaselinePreciseLabel : string.Empty)@(_proposedFrom.HasSubMillisecondBaseline && _proposedTo.HasSubMillisecondBaseline ? " / " : string.Empty)@(_proposedTo.HasSubMillisecondBaseline ? _proposedTo.BaselinePreciseLabel : string.Empty)
                    — the picker edits to millisecond precision; leaving a field untouched keeps its stored value exactly.
                </p>
            }
            <label>
                Change reason
                <input @bind="_reason" @bind:event="oninput" maxlength="500"
                       aria-label="Change reason" placeholder="Why is this change being made?">
            </label>
        </div>
        <p class="te-note">
            Proposed dates are advisory only — they never make a draft effective by themselves.
            Unchanged fields keep their stored values exactly; clearing a field clears the proposal.
        </p>

        <ErrorNotice Error="@_saveError">
            @if (_saveError?.IsUnauthorized == true)
            {
                <a href="@SignInUrl">Sign in again</a>
            }
        </ErrorNotice>

        @if (_draftConflict.IsOpen)
        {
            <ConflictNotice Busy="@_busy"
                            OnDiscard="DiscardDraftConflict"
                            OnReapply="ReapplyDraftConflictAsync">
                <LatestSummary>
                    Latest draft: @_draftConflictSummary
                    Your input is kept — choose whether to adopt the latest version or reapply yours.
                </LatestSummary>
            </ConflictNotice>
        }
        @if (_timelineConflict.IsOpen)
        {
            <ConflictNotice Busy="@_busy"
                            OnDiscard="DiscardTimelineConflict"
                            OnReapply="ReapplyTimelineConflictAsync">
                <LatestSummary>
                    Timeline now: @_timelineConflictSummary
                </LatestSummary>
            </ConflictNotice>
        }
        <div class="te-notice" aria-live="polite">@_notice</div>

        <div class="te-footer">
            <button type="button" class="te-primary" @onclick="SaveAsync" disabled="@_busy">
                @(_busy ? "Saving…" : "Save draft")
            </button>
            @if (IsNew is false)
            {
                <button type="button" @onclick="BeginApply" disabled="@_busy">Apply now</button>
                <button type="button" @onclick="BeginSchedule" disabled="@_busy">Schedule</button>
                <button type="button" @onclick="BeginDelete" disabled="@_busy">Delete draft</button>
            }
            <a href="instruments/@Id?tab=drafts" style="align-self:center">Cancel</a>
        </div>
    </section>

    <PendingActionPanel Action="@_pending"
                        Busy="@_busy"
                        Error="@_pendingError"
                        OnConfirm="ConfirmPendingAsync"
                        OnCancel="CancelPendingAsync"
                        OnInputChanged="OnPendingInputChanged" />
}

<DirtyGuard IsDirty="@AnyDirty" />

@code {
    private DefinitionEditModel _definition = DefinitionEditModel.Empty();
    private DefinitionEditModel _definitionBaseline = DefinitionEditModel.Empty();
    private MonitoringRuleRevisionDto? _draft;
    private ApiError? _fatal;
    private ApiError? _saveError;
    private ApiError? _pendingError;
    private bool _loading = true;
    private bool _busy;
    private PendingAction? _pending;
    private string? _notice;
    private string _instrumentLabel = string.Empty;
    private string _token = string.Empty;
    private string _reason = string.Empty;
    private string _reasonBaseline = string.Empty;
    private UtcTimeField _proposedFrom = new(null);
    private UtcTimeField _proposedTo = new(null);
    private readonly ConflictResolution<MonitoringRuleRevisionResponse> _draftConflict = new();
    private readonly ConflictResolution<MonitoringRuleTimelineResponse> _timelineConflict = new();
    private bool _headingFocusPending = true;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public Guid? DraftId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public Guid? CopyFrom { get; set; }

    private bool IsNew => DraftId is null;

    private string SignInUrl => AuthLinks.SignInUrl(Navigation);

    private bool Dirty =>
        _definition.SameContent(_definitionBaseline) is false
        || _reason != _reasonBaseline
        || _proposedFrom.Modified
        || _proposedTo.Modified;

    private bool AnyDirty => Dirty || _pending?.HasInput == true;

    private string _draftConflictSummary
    {
        get
        {
            MonitoringRuleRevisionDto? latest = _draftConflict.Latest?.Revision;
            if (latest is null)
            {
                return string.Empty;
            }

            string definition = latest.Definition is null
                ? "no definition"
                : DefinitionEditModel.FromDto(latest.Definition).DescribeChangesAgainst(_definition);
            return $"reason '{latest.ChangeReason ?? "—"}', proposed {UtcTimes.FormatRange(latest.ProposedEffectiveFrom, latest.ProposedEffectiveTo)}; {definition}";
        }
    }

    private string _timelineConflictSummary
    {
        get
        {
            MonitoringRuleTimelineResponse? timeline = _timelineConflict.Latest;
            if (timeline is null)
            {
                return string.Empty;
            }

            MonitoringRuleRevisionDto? newest = timeline.Revisions
                .OrderByDescending(revision => revision.CreatedAt)
                .FirstOrDefault();
            return newest is null
                ? $"{timeline.Revisions.Count} revisions"
                : $"{timeline.Revisions.Count} revisions; newest '{newest.ChangeReason ?? "—"}' {UtcTimes.FormatRange(newest.EffectiveFrom, newest.EffectiveTo)}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_headingFocusPending && _loading is false && _fatal is null)
        {
            _headingFocusPending = false;
            await JS.InvokeVoidAsync("teFocus", "h2");
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _fatal = null;
        _saveError = null;
        _pendingError = null;
        _pending = null;
        _draftConflict.Take();
        _timelineConflict.Take();
        _notice = null;

        ApiResult<WatchedInstrumentSettingsResponse> instrument =
            await Api.GetSettingsAsync(Id, _lifetime.Token);
        if (instrument.IsFailure)
        {
            _loading = false;
            _fatal = instrument.Error;
            return;
        }

        _instrumentLabel =
            $"{instrument.Value!.Symbol} · {instrument.Value.Exchange} · {instrument.Value.QuoteCurrency}";

        if (IsNew)
        {
            await LoadNewDraftAsync();
        }
        else
        {
            await LoadExistingDraftAsync();
        }

        _loading = false;
    }

    private void ReseedBaseline()
    {
        _definitionBaseline = _definition.Clone();
        _reasonBaseline = _reason;
        _proposedFrom.AcceptResolved();
        _proposedTo.AcceptResolved();
    }

    private async Task LoadNewDraftAsync()
    {
        _draft = null;
        ApiResult<MonitoringRuleTimelineResponse> timeline =
            await Api.GetTimelineAsync(Id, _lifetime.Token);
        if (timeline.IsFailure)
        {
            _fatal = timeline.Error;
            return;
        }

        _token = timeline.Value!.ConcurrencyToken;
        _definition = DefinitionEditModel.Empty();
        _reason = string.Empty;
        _proposedFrom.Reseed(null);
        _proposedTo.Reseed(null);

        if (CopyFrom is not null)
        {
            ApiResult<MonitoringRuleRevisionResponse> revision =
                await Api.GetRevisionAsync(Id, CopyFrom.Value, _lifetime.Token);
            if (revision.IsFailure)
            {
                _fatal = revision.Error;
                return;
            }

            if (revision.Value!.Revision.Definition is not null)
            {
                _definition = DefinitionEditModel.FromDto(revision.Value.Revision.Definition);
            }
        }

        if (_definition.SupportZones.Count == 0 && _definition.ResistanceZones.Count == 0)
        {
            _definition.AddSupportZone();
        }

        ReseedBaseline();
    }

    private async Task LoadExistingDraftAsync()
    {
        ApiResult<MonitoringRuleRevisionResponse> revision =
            await Api.GetRevisionAsync(Id, DraftId!.Value, _lifetime.Token);
        if (revision.IsFailure)
        {
            _fatal = revision.Error;
            return;
        }

        MonitoringRuleRevisionDto draft = revision.Value!.Revision;
        if (draft.EffectiveFrom is not null || draft.Kind == "committed")
        {
            _fatal = ApiError.Create(409, "draft.not_draft",
                "This revision is already committed and can no longer be edited as a draft.", null);
            return;
        }

        _draft = draft;
        _token = revision.Value.ConcurrencyToken;
        _definition = draft.Definition is null
            ? DefinitionEditModel.Empty()
            : DefinitionEditModel.FromDto(draft.Definition);
        _reason = draft.ChangeReason ?? string.Empty;
        _proposedFrom.Reseed(draft.ProposedEffectiveFrom);
        _proposedTo.Reseed(draft.ProposedEffectiveTo);
        ReseedBaseline();
    }

    private void OnDefinitionChanged()
    {
    }

    private async Task BeginApply()
    {
        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.Apply, _draft!, _token)
        {
            To = new UtcTimeField(_draft!.ProposedEffectiveTo)
        };
        _pendingError = null;
        _notice = null;
    }

    private async Task BeginSchedule()
    {
        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.Schedule, _draft!, _token)
        {
            From = new UtcTimeField(_draft!.ProposedEffectiveFrom),
            To = new UtcTimeField(_draft!.ProposedEffectiveTo)
        };
        _pendingError = null;
        _notice = null;
    }

    private async Task BeginDelete()
    {
        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.DeleteDraft, _draft!, _token);
        _pendingError = null;
        _notice = null;
    }

    private void OnPendingInputChanged()
    {
        StateHasChanged();
    }

    private async Task<bool> ConfirmDiscardPendingInputAsync()
    {
        if (_pending?.HasInput == true)
        {
            return await JS.InvokeAsync<bool>(
                "confirm",
                "Discard the times you entered for the current action?");
        }

        return true;
    }

    private async Task CancelPendingAsync()
    {
        if (_pending?.HasInput == true)
        {
            bool confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Discard the times you entered for this action?");
            if (confirmed is false)
            {
                return;
            }
        }

        _pending = null;
        _pendingError = null;
    }

    private ApiError? BuildDraftRequest(out MonitoringRuleDraftRequest? request)
    {
        request = null;
        ApiError? fromError = _proposedFrom.RequestOptional(out string? fromIso);
        if (fromError is not null)
        {
            return fromError;
        }

        ApiError? toError = _proposedTo.RequestOptional(out string? toIso);
        if (toError is not null)
        {
            return toError;
        }

        request = new MonitoringRuleDraftRequest(
            string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim(),
            new RevisionPeriodDto(fromIso, toIso),
            _definition.ToDto());
        return null;
    }

    private async Task<ApiResult<MonitoringRuleTimelineResponse>> SaveCoreAsync()
    {
        ApiError? validationError = BuildDraftRequest(out MonitoringRuleDraftRequest? request);
        if (validationError is not null)
        {
            return ApiResult<MonitoringRuleTimelineResponse>.Fail(validationError);
        }

        ApiResult<MonitoringRuleTimelineResponse> result = IsNew
            ? await Api.CreateDraftAsync(Id, request!, _token, _lifetime.Token)
            : await Api.UpdateDraftAsync(Id, DraftId!.Value, request!, _token, _lifetime.Token);

        if (result.IsSuccess)
        {
            _token = result.Value!.ConcurrencyToken;
            ReseedBaseline();
        }

        return result;
    }

    private async Task<bool> HandleMutationAsync(ApiResult<MonitoringRuleTimelineResponse> result)
    {
        if (result.IsSuccess)
        {
            return true;
        }

        if (result.Error!.IsPreconditionFailed)
        {
            await OpenConflictAsync();
        }
        else
        {
            _saveError = result.Error;
        }

        return false;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _notice = null;
        ApiResult<MonitoringRuleTimelineResponse> result;
        try
        {
            result = await SaveCoreAsync();
        }
        finally
        {
            _busy = false;
        }

        if (await HandleMutationAsync(result))
        {
            Navigation.NavigateTo($"instruments/{Id}?tab=drafts");
        }
    }

    private async Task ConfirmPendingAsync()
    {
        if (_pending is null)
        {
            return;
        }

        _busy = true;
        _saveError = null;
        _pendingError = null;

        try
        {
            ApiError? validationError = ResolvePendingInputs(out string? fromIso, out string? toIso);
            if (validationError is not null)
            {
                _pendingError = validationError;
                return;
            }

            if (Dirty)
            {
                ApiResult<MonitoringRuleTimelineResponse> saved = await SaveCoreAsync();
                if (await HandleMutationAsync(saved) is false)
                {
                    return;
                }
            }

            ApiResult<MonitoringRuleTimelineResponse> result;
            if (_pending.Kind == PendingActionKind.Apply)
            {
                result = await Api.ApplyDraftAsync(
                    Id,
                    DraftId!.Value,
                    new ApplyMonitoringRuleRequest(toIso),
                    _token,
                    _lifetime.Token);
            }
            else if (_pending.Kind == PendingActionKind.Schedule)
            {
                result = await Api.ScheduleDraftAsync(
                    Id,
                    DraftId!.Value,
                    new ScheduleMonitoringRuleRequest(fromIso, toIso),
                    _token,
                    _lifetime.Token);
            }
            else
            {
                result = await Api.DeleteDraftAsync(Id, DraftId!.Value, _token, _lifetime.Token);
            }

            if (await HandleMutationAsync(result))
            {
                string tab = _pending.Kind == PendingActionKind.Apply
                    ? "current"
                    : _pending.Kind == PendingActionKind.Schedule
                        ? "timeline"
                        : "drafts";
                _pending = null;
                _pendingError = null;
                Navigation.NavigateTo($"instruments/{Id}?tab={tab}");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private ApiError? ResolvePendingInputs(out string? effectiveFromIso, out string? effectiveToIso)
    {
        effectiveFromIso = null;
        effectiveToIso = null;

        if (_pending!.Kind == PendingActionKind.Schedule)
        {
            ApiError? fromError = _pending.From!.RequestRequired(out effectiveFromIso);
            if (fromError is not null)
            {
                return fromError;
            }
        }

        if (_pending.Kind is PendingActionKind.Apply or PendingActionKind.Schedule)
        {
            ApiError? toError = _pending.To!.RequestOptional(out effectiveToIso);
            if (toError is not null)
            {
                return toError;
            }
        }

        return null;
    }

    private async Task OpenConflictAsync()
    {
        if (IsNew)
        {
            ApiResult<MonitoringRuleTimelineResponse> timeline =
                await Api.GetTimelineAsync(Id, _lifetime.Token);
            if (timeline.IsSuccess)
            {
                _timelineConflict.Open(timeline.Value!);
            }
            else
            {
                _saveError = timeline.Error;
            }

            return;
        }

        ApiResult<MonitoringRuleRevisionResponse> latest =
            await Api.GetRevisionAsync(Id, DraftId!.Value, _lifetime.Token);
        if (latest.IsSuccess)
        {
            _draftConflict.Open(latest.Value!);
        }
        else
        {
            _saveError = latest.Error;
        }
    }

    private void DiscardTimelineConflict()
    {
        MonitoringRuleTimelineResponse latest = _timelineConflict.Take();
        _token = latest.ConcurrencyToken;
        _definition = DefinitionEditModel.Empty();
        _definition.AddSupportZone();
        _reason = string.Empty;
        _proposedFrom.Reseed(null);
        _proposedTo.Reseed(null);
        ReseedBaseline();
        _notice = "Latest timeline loaded — your unsaved draft input was discarded.";
    }

    private async Task ReapplyTimelineConflictAsync()
    {
        MonitoringRuleTimelineResponse latest = _timelineConflict.Take();
        _token = latest.ConcurrencyToken;
        if (_pending is not null)
        {
            await ConfirmPendingAsync();
        }
        else
        {
            await SaveAsync();
        }
    }

    private void DiscardDraftConflict()
    {
        MonitoringRuleRevisionResponse latest = _draftConflict.Take();
        MonitoringRuleRevisionDto draft = latest.Revision;
        if (draft.EffectiveFrom is not null || draft.Kind == "committed")
        {
            _fatal = ApiError.Create(409, "draft.not_draft",
                "This revision is already committed and can no longer be edited as a draft.", null);
            return;
        }

        _draft = draft;
        _token = latest.ConcurrencyToken;
        _definition = draft.Definition is null
            ? DefinitionEditModel.Empty()
            : DefinitionEditModel.FromDto(draft.Definition);
        _reason = draft.ChangeReason ?? string.Empty;
        _proposedFrom.Reseed(draft.ProposedEffectiveFrom);
        _proposedTo.Reseed(draft.ProposedEffectiveTo);
        ReseedBaseline();
        _notice = "Latest draft loaded — your input was discarded.";
    }

    private async Task ReapplyDraftConflictAsync()
    {
        MonitoringRuleRevisionResponse latest = _draftConflict.Take();
        _token = latest.ConcurrencyToken;
        if (_pending is not null)
        {
            await ConfirmPendingAsync();
        }
        else
        {
            await SaveAsync();
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
