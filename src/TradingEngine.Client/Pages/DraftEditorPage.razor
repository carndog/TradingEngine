@page "/instruments/{Id:guid}/drafts/new"
@page "/instruments/{Id:guid}/drafts/{DraftId:guid}"
@inject TradingEngineApiClient Api
@inject NavigationManager Navigation
@inject IUiClock Clock
@inject IJSRuntime JS
@implements IDisposable

<div class="te-back">
    <a href="instruments/@Id?tab=drafts">← Back to drafts</a>
</div>

@if (_fatal is not null)
{
    <ErrorNotice Error="@_fatal">
        <button type="button" @onclick="LoadAsync">Retry</button>
        @if (_fatal.IsUnauthorized)
        {
            <a href="@SignInUrl">Sign in again</a>
        }
    </ErrorNotice>
}
else if (_loading)
{
    <div class="te-panel" role="status"><p class="te-sub">Loading…</p></div>
}
else
{
    <h2 tabindex="-1">@(IsNew ? "New draft" : "Edit draft")</h2>
    <p class="te-sub">@_instrumentLabel</p>
    @if (_draft is not null)
    {
        <p class="te-sub">@RevisionLabels.DraftTitle(_draft) · created @UtcTimes.FormatWithSeconds(_draft.CreatedAt) by @ActorPresentation.Describe(_draft)</p>
    }

    <div class="te-editor">
        <div class="te-editor-head">
            <div class="te-row">
                <div>
                    <strong>Draft definition</strong>
                    <p class="te-note">Drafts do not become effective until applied or scheduled.</p>
                </div>
                @if (Dirty)
                {
                    <span class="te-tag te-dirty">Unsaved changes</span>
                }
            </div>
        </div>
        <DefinitionEditor Model="@_definition" OnChanged="OnDefinitionChanged" />
    </div>

    <section class="te-detail-card" aria-label="Draft options">
        <h3>Options</h3>
        <div class="te-fields">
            <label>
                Proposed start (UTC, optional)
                <input type="datetime-local" step="0.001" value="@_proposedFrom.Text"
                       @onchange="OnProposedFromChanged"
                       aria-label="Proposed effective from UTC"
                       aria-invalid="@(_saveError?.Code == ProposedStartPastCode ? "true" : null)">
            </label>
            @if (StoredProposalIsPast)
            {
                <p class="te-alert te-warn" role="status" style="margin-top:0">
                    The stored proposed start @UtcTimes.Format(_proposedFrom.Baseline!.Value) has already passed. It is kept as recorded intent; enter a future start or clear it before scheduling.
                </p>
            }
            <label>
                Proposed end (UTC, optional)
                <input type="datetime-local" step="0.001" value="@_proposedTo.Text"
                       @onchange="args => _proposedTo.Set(args.Value?.ToString())"
                       aria-label="Proposed effective to UTC">
            </label>
            @if (_proposedFrom.HasSubMillisecondBaseline || _proposedTo.HasSubMillisecondBaseline)
            {
                <p class="te-note">
                    Stored values @(_proposedFrom.HasSubMillisecondBaseline ? _proposedFrom.BaselinePreciseLabel : string.Empty)@(_proposedFrom.HasSubMillisecondBaseline && _proposedTo.HasSubMillisecondBaseline ? " / " : string.Empty)@(_proposedTo.HasSubMillisecondBaseline ? _proposedTo.BaselinePreciseLabel : string.Empty)
                    — the picker edits to millisecond precision; leaving a field untouched keeps its stored value exactly.
                </p>
            }
            <label>
                Change reason
                <input @bind="_reason" @bind:event="oninput" maxlength="500"
                       aria-label="Change reason" placeholder="Why is this change being made?">
            </label>
        </div>
        <p class="te-note">
            Proposed dates are advisory only — they never make a draft effective by themselves.
            Unchanged fields keep their stored values exactly; clearing a field clears the proposal.
        </p>

        <ErrorNotice Error="@_saveError">
            @if (_saveError?.IsUnauthorized == true)
            {
                <a href="@SignInUrl">Sign in again</a>
            }
        </ErrorNotice>

        @if (_createOutcomeUnknown && IsNew)
        {
            <div class="te-alert te-warn" role="status">
                <p style="margin:0">
                    The previous save may already have created a draft — the response was lost, so saving again could create a duplicate. Your input is kept.
                </p>
                <div class="te-row" style="justify-content:flex-start;gap:12px;margin-top:8px">
                    <button type="button" @onclick="ReconcileCreateAsync" disabled="@_busy">Check saved drafts</button>
                    <a href="instruments/@Id?tab=drafts">Open draft list</a>
                </div>
            </div>
        }

        @if (_draftConflict.IsOpen)
        {
            <ConflictNotice Busy="@_busy"
                            OnDiscard="DiscardDraftConflict"
                            OnReapply="ReapplyDraftConflictAsync">
                <LatestSummary>
                    Latest draft: @_draftConflictSummary
                    Your input is kept — choose whether to adopt the latest version or reapply yours.
                </LatestSummary>
            </ConflictNotice>
        }
        @if (_timelineConflict.IsOpen)
        {
            <ConflictNotice Busy="@_busy"
                            OnDiscard="DiscardTimelineConflict"
                            OnReapply="ReapplyTimelineConflictAsync">
                <LatestSummary>
                    Timeline now: @_timelineConflictSummary
                </LatestSummary>
            </ConflictNotice>
        }
        <div class="te-notice" aria-live="polite">@_notice</div>

        <div class="te-footer">
            <button type="button" class="te-primary" @onclick="SaveAsync" disabled="@_busy">
                @(_busy ? "Saving…" : "Save draft")
            </button>
            @if (IsNew is false)
            {
                <button type="button" @onclick="BeginApply" disabled="@_busy">Apply now</button>
                <button type="button" @onclick="BeginSchedule" disabled="@_busy">Schedule</button>
                <button type="button" @onclick="BeginDelete" disabled="@_busy">Delete draft</button>
            }
            <a href="instruments/@Id?tab=drafts" style="align-self:center">Cancel</a>
        </div>
    </section>

    <PendingActionPanel Action="@_pending"
                        Busy="@_busy"
                        Error="@_pendingError"
                        Timeline="@_timeline"
                        OnConfirm="ConfirmPendingAsync"
                        OnCancel="CancelPendingAsync"
                        OnInputChanged="OnPendingInputChanged" />
}

<DirtyGuard IsDirty="@(() => AnyDirty)" />

@code {
    private const string ProposedStartPastCode = "draft.proposed_start_past";

    private DefinitionEditModel _definition = DefinitionEditModel.Empty();
    private DefinitionEditModel _definitionBaseline = DefinitionEditModel.Empty();
    private MonitoringRuleRevisionDto? _draft;
    private MonitoringRuleTimelineResponse? _timeline;
    private Guid? _createdDraftId;
    private ApiError? _fatal;
    private ApiError? _saveError;
    private ApiError? _pendingError;
    private bool _loading = true;
    private bool _busy;
    private PendingAction? _pending;
    private string? _notice;
    private string _instrumentLabel = string.Empty;
    private string _token = string.Empty;
    private string _reason = string.Empty;
    private string _reasonBaseline = string.Empty;
    private UtcTimeField _proposedFrom = new(null);
    private UtcTimeField _proposedTo = new(null);
    private readonly ConflictResolution<MonitoringRuleRevisionResponse> _draftConflict = new();
    private readonly ConflictResolution<MonitoringRuleTimelineResponse> _timelineConflict = new();
    private bool _headingFocusPending = true;
    private bool _parametersApplied;
    private Guid _loadedId;
    private Guid? _loadedDraftId;
    private Guid? _loadedCopyFrom;
    private bool _createOutcomeUnknown;
    private PendingCreate? _pendingCreate;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public Guid? DraftId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public Guid? CopyFrom { get; set; }

    private Guid? SavedDraftId => DraftId ?? _createdDraftId;

    private bool IsNew => SavedDraftId is null;

    internal Guid? CreatedDraftId => _createdDraftId;

    private string SignInUrl => AuthLinks.SignInUrl(Navigation);

    private bool StoredProposalIsPast =>
        _proposedFrom.Modified is false
        && _proposedFrom.Baseline is not null
        && _proposedFrom.Baseline.Value < Clock.UtcNow;

    private bool Dirty =>
        _definition.SameContent(_definitionBaseline) is false
        || _reason != _reasonBaseline
        || _proposedFrom.Modified
        || _proposedTo.Modified;

    private bool AnyDirty => Dirty || _pending?.HasInput == true;

    private string _draftConflictSummary
    {
        get
        {
            MonitoringRuleRevisionDto? latest = _draftConflict.Latest?.Revision;
            if (latest is null)
            {
                return string.Empty;
            }

            string definition = latest.Definition is null
                ? "no definition"
                : DefinitionEditModel.FromDto(latest.Definition).DescribeChangesAgainst(_definition);
            return $"reason '{latest.ChangeReason ?? "—"}', proposed {UtcTimes.FormatRange(latest.ProposedEffectiveFrom, latest.ProposedEffectiveTo)}; {definition}";
        }
    }

    private string _timelineConflictSummary
    {
        get
        {
            MonitoringRuleTimelineResponse? timeline = _timelineConflict.Latest;
            if (timeline is null)
            {
                return string.Empty;
            }

            MonitoringRuleRevisionDto? newest = timeline.Revisions
                .OrderByDescending(revision => revision.CreatedAt)
                .FirstOrDefault();
            return newest is null
                ? $"{timeline.Revisions.Count} revisions"
                : $"{timeline.Revisions.Count} revisions; newest '{newest.ChangeReason ?? "—"}' {UtcTimes.FormatRange(newest.EffectiveFrom, newest.EffectiveTo)}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_parametersApplied
            && Id == _loadedId
            && DraftId == _loadedDraftId
            && CopyFrom == _loadedCopyFrom)
        {
            return;
        }

        _parametersApplied = true;
        _loadedId = Id;
        _loadedDraftId = DraftId;
        _loadedCopyFrom = CopyFrom;
        _createdDraftId = null;
        _createOutcomeUnknown = false;
        _pendingCreate = null;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_headingFocusPending && _loading is false && _fatal is null)
        {
            _headingFocusPending = false;
            await JS.InvokeVoidAsync("teFocus", "h2");
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _fatal = null;
        _saveError = null;
        _pendingError = null;
        _pending = null;
        _draftConflict.Take();
        _timelineConflict.Take();
        _notice = null;

        ApiResult<WatchedInstrumentSettingsResponse> instrument =
            await Api.GetSettingsAsync(Id, _lifetime.Token);
        if (instrument.IsFailure)
        {
            _loading = false;
            _fatal = instrument.Error;
            return;
        }

        _instrumentLabel =
            $"{instrument.Value!.Symbol} · {instrument.Value.Exchange} · {instrument.Value.QuoteCurrency}";

        if (IsNew)
        {
            await LoadNewDraftAsync();
        }
        else
        {
            await LoadExistingDraftAsync();
        }

        _loading = false;
    }

    private void ReseedBaseline()
    {
        _definitionBaseline = _definition.Clone();
        _reasonBaseline = _reason;
        _proposedFrom.AcceptResolved();
        _proposedTo.AcceptResolved();
    }

    private async Task LoadNewDraftAsync()
    {
        _draft = null;
        ApiResult<MonitoringRuleTimelineResponse> timeline =
            await Api.GetTimelineAsync(Id, _lifetime.Token);
        if (timeline.IsFailure)
        {
            _fatal = timeline.Error;
            return;
        }

        _timeline = timeline.Value;
        _token = timeline.Value!.ConcurrencyToken;
        _definition = DefinitionEditModel.Empty();
        _reason = string.Empty;
        _proposedFrom.Reseed(null);
        _proposedTo.Reseed(null);

        if (CopyFrom is not null)
        {
            ApiResult<MonitoringRuleRevisionResponse> revision =
                await Api.GetRevisionAsync(Id, CopyFrom.Value, _lifetime.Token);
            if (revision.IsFailure)
            {
                _fatal = revision.Error;
                return;
            }

            if (revision.Value!.Revision.Definition is not null)
            {
                _definition = DefinitionEditModel.FromDto(revision.Value.Revision.Definition);
            }
        }

        if (_definition.SupportZones.Count == 0 && _definition.ResistanceZones.Count == 0)
        {
            _definition.AddSupportZone();
        }

        ReseedBaseline();
    }

    private async Task LoadExistingDraftAsync()
    {
        Task<ApiResult<MonitoringRuleRevisionResponse>> revisionTask =
            Api.GetRevisionAsync(Id, SavedDraftId!.Value, _lifetime.Token);
        Task<ApiResult<MonitoringRuleTimelineResponse>> timelineTask =
            Api.GetTimelineAsync(Id, _lifetime.Token);
        await Task.WhenAll(revisionTask, timelineTask);

        ApiResult<MonitoringRuleRevisionResponse> revision = revisionTask.Result;
        if (revision.IsFailure || revision.Value?.Revision is null)
        {
            _fatal = revision.Error ?? ApiError.Create(
                0, "response.unexpected", "The draft could not be loaded.", null);
            return;
        }

        _timeline = timelineTask.Result.Value;

        MonitoringRuleRevisionDto draft = revision.Value!.Revision;
        if (draft.EffectiveFrom is not null || draft.Kind == "committed")
        {
            _fatal = ApiError.Create(409, "draft.not_draft",
                "This revision is already committed and can no longer be edited as a draft.", null);
            return;
        }

        _draft = draft;
        _token = revision.Value.ConcurrencyToken;
        _definition = draft.Definition is null
            ? DefinitionEditModel.Empty()
            : DefinitionEditModel.FromDto(draft.Definition);
        _reason = draft.ChangeReason ?? string.Empty;
        _proposedFrom.Reseed(draft.ProposedEffectiveFrom);
        _proposedTo.Reseed(draft.ProposedEffectiveTo);
        ReseedBaseline();
    }

    private void OnDefinitionChanged()
    {
    }

    private void OnProposedFromChanged(ChangeEventArgs args)
    {
        _proposedFrom.Set(args.Value?.ToString());
        if (_pending?.Kind == PendingActionKind.Apply)
        {
            _pending.ProposedEffectiveFrom = EditedProposedStart();
            _pending.ProposalReplacementAcknowledged = false;
        }
    }

    private async Task BeginApply()
    {
        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.Apply, _draft!, _token)
        {
            To = new UtcTimeField(_draft!.ProposedEffectiveTo),
            ProposedEffectiveFrom = EditedProposedStart()
        };
        _pendingError = null;
        _notice = null;
    }

    private DateTimeOffset? EditedProposedStart()
    {
        UtcTimeResolution resolved = _proposedFrom.Resolve();
        return resolved.Kind == UtcTimeResolutionKind.Invalid
            ? _draft?.ProposedEffectiveFrom
            : resolved.Value;
    }

    private async Task BeginSchedule()
    {
        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.Schedule, _draft!, _token)
        {
            From = new UtcTimeField(_draft!.ProposedEffectiveFrom),
            To = new UtcTimeField(_draft!.ProposedEffectiveTo)
        };
        _pendingError = null;
        _notice = null;
    }

    private async Task BeginDelete()
    {
        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.DeleteDraft, _draft!, _token);
        _pendingError = null;
        _notice = null;
    }

    private void OnPendingInputChanged()
    {
        StateHasChanged();
    }

    private async Task<bool> ConfirmDiscardPendingInputAsync()
    {
        if (_pending?.HasInput == true)
        {
            return await JS.InvokeAsync<bool>(
                "confirm",
                "Discard the times you entered for the current action?");
        }

        return true;
    }

    private async Task CancelPendingAsync()
    {
        if (_pending?.HasInput == true)
        {
            bool confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Discard the times you entered for this action?");
            if (confirmed is false)
            {
                return;
            }
        }

        _pending = null;
        _pendingError = null;
    }

    private ApiError? BuildDraftRequest(out MonitoringRuleDraftRequest? request)
    {
        request = null;
        ApiError? fromError = _proposedFrom.RequestOptional(out string? fromIso);
        if (fromError is not null)
        {
            return fromError;
        }

        ApiError? pastError = RejectNewlyEnteredPastProposedStart();
        if (pastError is not null)
        {
            return pastError;
        }

        ApiError? toError = _proposedTo.RequestOptional(out string? toIso);
        if (toError is not null)
        {
            return toError;
        }

        request = new MonitoringRuleDraftRequest(
            string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim(),
            new RevisionPeriodDto(fromIso, toIso),
            _definition.ToDto());
        return null;
    }

    private ApiError? RejectNewlyEnteredPastProposedStart()
    {
        UtcTimeResolution resolved = _proposedFrom.Resolve();
        if (resolved.Kind != UtcTimeResolutionKind.Valid || resolved.Value is null)
        {
            return null;
        }

        DateTimeOffset now = Clock.UtcNow;
        if (resolved.Value.Value >= now)
        {
            return null;
        }

        return ApiError.Create(400, ProposedStartPastCode,
            $"Proposed start {UtcTimes.Format(resolved.Value.Value)} is in the past (now {UtcTimes.Format(now)}). "
            + "Enter a future start or clear the field. Your input has been kept and nothing was saved.",
            null);
    }

    private async Task<ApiResult<MonitoringRuleTimelineResponse>> SaveCoreAsync()
    {
        ApiError? validationError = BuildDraftRequest(out MonitoringRuleDraftRequest? request);
        if (validationError is not null)
        {
            return ApiResult<MonitoringRuleTimelineResponse>.Fail(validationError);
        }

        if (IsNew && _createOutcomeUnknown)
        {
            return ApiResult<MonitoringRuleTimelineResponse>.Fail(ApiError.Create(
                409,
                "draft.create_outcome_unknown",
                "The previous save may have created a draft but its outcome is unknown. "
                + "Check the saved drafts before saving again so the draft is not created twice.",
                null));
        }

        DraftBaseline submitted = CaptureBaseline();

        if (IsNew)
        {
            return await CreateDraftCoreAsync(request!, submitted);
        }

        ApiResult<MonitoringRuleTimelineResponse> result =
            await Api.UpdateDraftAsync(Id, SavedDraftId!.Value, request!, _token, _lifetime.Token);
        if (result.IsSuccess)
        {
            _token = result.Value!.ConcurrencyToken;
            _timeline = result.Value;
            AcceptBaseline(submitted);
        }

        return result;
    }

    private DraftBaseline CaptureBaseline()
    {
        return new DraftBaseline(
            _definition.Clone(),
            _reason,
            _proposedFrom.Resolve().Value,
            _proposedFrom.Text,
            _proposedTo.Resolve().Value,
            _proposedTo.Text);
    }

    private void AcceptBaseline(DraftBaseline baseline)
    {
        _definitionBaseline = baseline.Definition;
        _reasonBaseline = baseline.Reason;
        _proposedFrom.AcceptBaseline(
            baseline.ProposedFrom, _proposedFrom.Text != baseline.ProposedFromText);
        _proposedTo.AcceptBaseline(
            baseline.ProposedTo, _proposedTo.Text != baseline.ProposedToText);
    }

    private sealed record DraftBaseline(
        DefinitionEditModel Definition,
        string Reason,
        DateTimeOffset? ProposedFrom,
        string ProposedFromText,
        DateTimeOffset? ProposedTo,
        string ProposedToText);

    private sealed record PendingCreate(
        MonitoringRuleDraftRequest Request,
        DateTimeOffset? ProposedFrom,
        DateTimeOffset? ProposedTo,
        DateTimeOffset AttemptedAt);

    private async Task<ApiResult<MonitoringRuleTimelineResponse>> CreateDraftCoreAsync(
        MonitoringRuleDraftRequest request,
        DraftBaseline submitted)
    {
        _pendingCreate = new PendingCreate(
            request, submitted.ProposedFrom, submitted.ProposedTo, Clock.UtcNow);

        ApiResult<MonitoringRuleRevisionResponse> created =
            await Api.CreateDraftAsync(Id, request, _token, _lifetime.Token);
        if (created.IsFailure)
        {
            if (created.Error!.Status == 0 || created.Error.Status >= 500)
            {
                _createOutcomeUnknown = true;
            }
            else
            {
                _pendingCreate = null;
            }

            return ApiResult<MonitoringRuleTimelineResponse>.Fail(created.Error!);
        }

        _createOutcomeUnknown = false;
        _pendingCreate = null;
        _token = created.Value!.ConcurrencyToken;
        _draft = created.Value.Revision;
        _createdDraftId = created.Value.Revision.Id;
        AcceptBaseline(submitted);

        return ApiResult<MonitoringRuleTimelineResponse>.Ok(
            _timeline is null
                ? new MonitoringRuleTimelineResponse(Guid.Empty, Id, _token, null, [])
                : _timeline with { ConcurrencyToken = _token });
    }

    private async Task ReconcileCreateAsync()
    {
        _busy = true;
        _notice = null;
        try
        {
            ApiResult<MonitoringRuleDraftsResponse> drafts =
                await Api.GetDraftsAsync(Id, _lifetime.Token);
            if (drafts.IsFailure)
            {
                _saveError = drafts.Error;
                return;
            }

            IReadOnlyList<MonitoringRuleRevisionDto> existing = drafts.Value!.Drafts;
            if (existing.Count == 0)
            {
                _createOutcomeUnknown = false;
                _pendingCreate = null;
                _saveError = null;
                _notice = "No draft exists on the server — the earlier save did not complete. "
                    + "Your input is kept; save again to create it.";
                return;
            }

            List<MonitoringRuleRevisionDto> matches = existing.Where(IsPendingCreateMatch).ToList();
            if (matches.Count == 0)
            {
                _notice = existing.Count == 1
                    ? "A draft exists on the server but could not be confirmed as the one your save "
                        + "created — open the draft list to review it before saving again."
                    : "Drafts exist on the server but none could be confirmed as the one your save "
                        + "created — open the draft list to review them before saving again.";
                return;
            }

            if (matches.Count > 1)
            {
                _notice = "More than one draft could be the one your save created — "
                    + "open the draft list to review them before saving again.";
                return;
            }

            ApiResult<MonitoringRuleRevisionResponse> revision =
                await Api.GetRevisionAsync(Id, matches[0].Id, _lifetime.Token);
            if (revision.IsFailure)
            {
                _saveError = revision.Error;
                return;
            }

            MonitoringRuleRevisionDto? adopted = revision.Value?.Revision;
            if (adopted is null || adopted.EffectiveFrom is not null || adopted.Kind == "committed")
            {
                _notice = "The existing draft is no longer editable — open the draft list to review it.";
                return;
            }

            _draft = adopted;
            _createdDraftId = adopted.Id;
            _token = revision.Value!.ConcurrencyToken;
            _createOutcomeUnknown = false;
            _pendingCreate = null;
            _saveError = null;
            _definitionBaseline = adopted.Definition is null
                ? DefinitionEditModel.Empty()
                : DefinitionEditModel.FromDto(adopted.Definition);
            _reasonBaseline = adopted.ChangeReason ?? string.Empty;
            _proposedFrom.AcceptBaseline(adopted.ProposedEffectiveFrom, _proposedFrom.Modified);
            _proposedTo.AcceptBaseline(adopted.ProposedEffectiveTo, _proposedTo.Modified);
            _notice = "Loaded the existing draft — your input is kept and will update it on the next save.";
        }
        finally
        {
            _busy = false;
        }
    }

    private bool IsPendingCreateMatch(MonitoringRuleRevisionDto draft)
    {
        PendingCreate? pending = _pendingCreate;
        if (pending is null
            || draft.CreatedByCaller is false
            || draft.CreatedAt < pending.AttemptedAt)
        {
            return false;
        }

        return draft.ChangeReason == pending.Request.ChangeReason
            && draft.ProposedEffectiveFrom == pending.ProposedFrom
            && draft.ProposedEffectiveTo == pending.ProposedTo
            && draft.Definition is not null
            && pending.Request.Definition is not null
            && SameDefinition(draft.Definition, pending.Request.Definition);
    }

    private static bool SameDefinition(
        MonitoringRuleDefinitionDto returned,
        MonitoringRuleDefinitionDto submitted)
    {
        return returned.PriceScale == submitted.PriceScale
            && SameZones(returned.SupportZones, submitted.SupportZones)
            && SameZones(returned.ResistanceZones, submitted.ResistanceZones);
    }

    private static bool SameZones(
        IReadOnlyList<ChartZoneDto>? returned,
        IReadOnlyList<ChartZoneDto>? submitted)
    {
        if (returned is null || submitted is null)
        {
            return returned is null && submitted is null;
        }

        return returned.Count == submitted.Count
            && returned.Zip(submitted).All(pair => SameZone(pair.First, pair.Second));
    }

    private static bool SameZone(ChartZoneDto returned, ChartZoneDto submitted)
    {
        return (returned.Id ?? string.Empty) == (submitted.Id ?? string.Empty)
            && returned.Lower == submitted.Lower
            && returned.Level == submitted.Level
            && returned.Upper == submitted.Upper
            && SameConditions(returned.Conditions, submitted.Conditions);
    }

    private static bool SameConditions(
        IReadOnlyList<ChartConditionDto>? returned,
        IReadOnlyList<ChartConditionDto>? submitted)
    {
        if (returned is null || submitted is null)
        {
            return returned is null && submitted is null;
        }

        return returned.Count == submitted.Count
            && returned.Zip(submitted).All(pair =>
                (pair.First.Type ?? string.Empty) == (pair.Second.Type ?? string.Empty)
                && (pair.First.ActionId ?? string.Empty) == (pair.Second.ActionId ?? string.Empty));
    }

    private async Task<bool> HandleMutationAsync(ApiResult<MonitoringRuleTimelineResponse> result)
    {
        if (result.IsSuccess)
        {
            return true;
        }

        if (result.Error!.IsPreconditionFailed)
        {
            await OpenConflictAsync();
        }
        else
        {
            _saveError = result.Error;
        }

        return false;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _notice = null;
        _saveError = null;
        ApiResult<MonitoringRuleTimelineResponse> result;
        try
        {
            result = await SaveCoreAsync();
        }
        finally
        {
            _busy = false;
        }

        if (await HandleMutationAsync(result))
        {
            Navigation.NavigateTo($"instruments/{Id}?tab=drafts&focus={SavedDraftId}");
        }
    }

    private async Task ConfirmPendingAsync()
    {
        if (_pending is null)
        {
            return;
        }

        _busy = true;
        _saveError = null;
        _pendingError = null;

        try
        {
            ApiError? validationError = _pending.ResolveInputs(
                Clock.UtcNow, out string? fromIso, out string? toIso);
            if (validationError is not null)
            {
                _pendingError = validationError;
                return;
            }

            if (Dirty)
            {
                ApiResult<MonitoringRuleTimelineResponse> saved = await SaveCoreAsync();
                if (await HandleMutationAsync(saved) is false)
                {
                    return;
                }
            }

            Guid draftId = SavedDraftId!.Value;
            ApiResult<MonitoringRuleTimelineResponse> result;
            if (_pending.Kind == PendingActionKind.Apply)
            {
                result = await Api.ApplyDraftAsync(
                    Id,
                    draftId,
                    new ApplyMonitoringRuleRequest(toIso),
                    _token,
                    _lifetime.Token);
            }
            else if (_pending.Kind == PendingActionKind.Schedule)
            {
                result = await Api.ScheduleDraftAsync(
                    Id,
                    draftId,
                    new ScheduleMonitoringRuleRequest(fromIso, toIso),
                    _token,
                    _lifetime.Token);
            }
            else
            {
                result = await Api.DeleteDraftAsync(Id, draftId, _token, _lifetime.Token);
            }

            if (await HandleMutationAsync(result))
            {
                string tab = _pending.Kind == PendingActionKind.Apply
                    ? "current"
                    : _pending.Kind == PendingActionKind.Schedule
                        ? "timeline"
                        : "drafts";
                string focus = _pending.Kind == PendingActionKind.DeleteDraft
                    ? string.Empty
                    : $"&focus={draftId}";
                _pending = null;
                _pendingError = null;
                Navigation.NavigateTo($"instruments/{Id}?tab={tab}{focus}");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenConflictAsync()
    {
        if (IsNew)
        {
            ApiResult<MonitoringRuleTimelineResponse> timeline =
                await Api.GetTimelineAsync(Id, _lifetime.Token);
            if (timeline.IsSuccess)
            {
                _timelineConflict.Open(timeline.Value!);
            }
            else
            {
                _saveError = timeline.Error;
            }

            return;
        }

        ApiResult<MonitoringRuleRevisionResponse> latest =
            await Api.GetRevisionAsync(Id, SavedDraftId!.Value, _lifetime.Token);
        if (latest.IsSuccess)
        {
            _draftConflict.Open(latest.Value!);
        }
        else
        {
            _saveError = latest.Error;
        }
    }

    private void DiscardTimelineConflict()
    {
        MonitoringRuleTimelineResponse latest = _timelineConflict.Take();
        _token = latest.ConcurrencyToken;
        _timeline = latest;
        _definition = DefinitionEditModel.Empty();
        _definition.AddSupportZone();
        _reason = string.Empty;
        _proposedFrom.Reseed(null);
        _proposedTo.Reseed(null);
        ReseedBaseline();
        _notice = "Latest timeline loaded — your unsaved draft input was discarded.";
    }

    private async Task ReapplyTimelineConflictAsync()
    {
        MonitoringRuleTimelineResponse latest = _timelineConflict.Take();
        _token = latest.ConcurrencyToken;
        _timeline = latest;
        if (_pending is not null)
        {
            await ConfirmPendingAsync();
        }
        else
        {
            await SaveAsync();
        }
    }

    private void DiscardDraftConflict()
    {
        MonitoringRuleRevisionResponse latest = _draftConflict.Take();
        MonitoringRuleRevisionDto draft = latest.Revision;
        if (draft.EffectiveFrom is not null || draft.Kind == "committed")
        {
            _fatal = ApiError.Create(409, "draft.not_draft",
                "This revision is already committed and can no longer be edited as a draft.", null);
            return;
        }

        _draft = draft;
        _token = latest.ConcurrencyToken;
        _definition = draft.Definition is null
            ? DefinitionEditModel.Empty()
            : DefinitionEditModel.FromDto(draft.Definition);
        _reason = draft.ChangeReason ?? string.Empty;
        _proposedFrom.Reseed(draft.ProposedEffectiveFrom);
        _proposedTo.Reseed(draft.ProposedEffectiveTo);
        ReseedBaseline();
        _notice = "Latest draft loaded — your input was discarded.";
    }

    private async Task ReapplyDraftConflictAsync()
    {
        MonitoringRuleRevisionResponse latest = _draftConflict.Take();
        _token = latest.ConcurrencyToken;
        if (_pending is not null)
        {
            await ConfirmPendingAsync();
        }
        else
        {
            await SaveAsync();
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
