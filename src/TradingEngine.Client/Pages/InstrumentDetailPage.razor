@page "/instruments/{Id:guid}"
@inject TradingEngineApiClient Api
@inject NavigationManager Navigation
@inject InstrumentListState ListState
@inject IUiClock Clock
@inject IJSRuntime JS
@implements IDisposable

<div class="te-back">
    <a href="@ListState.ListUrl">← Back to instruments</a>
</div>

@if (_fatal is not null)
{
    <ErrorNotice Error="@_fatal">
        <button type="button" @onclick="ReloadAllAsync">Retry</button>
        @if (_fatal.IsUnauthorized)
        {
            <a href="@SignInUrl">Sign in again</a>
        }
    </ErrorNotice>
}
else if (_settings is null)
{
    <div class="te-panel" role="status"><p class="te-sub">Loading instrument…</p></div>
}
else
{
    <h2 tabindex="-1">@_settings.Symbol</h2>
    <p class="te-sub">@_settings.Exchange · @_settings.QuoteCurrency · @_settings.SamplingIntervalSeconds s interval</p>
    <div class="te-row" style="justify-content:flex-start;margin-top:10px">
        <MonitoringBadge State="@_settings.MonitoringState" />
        <span class="te-small">Last changed @UtcTimes.Format(_settings.LastChangedAt)</span>
    </div>

    <div class="te-tabs" role="group" aria-label="Instrument views">
        <button type="button" aria-pressed="@(_tab == "current")" @onclick='() => SelectTab("current")'>Current</button>
        <button type="button" aria-pressed="@(_tab == "drafts")" @onclick='() => SelectTab("drafts")'>Drafts</button>
        <button type="button" aria-pressed="@(_tab == "timeline")" @onclick='() => SelectTab("timeline")'>Timeline</button>
        <button type="button" aria-pressed="@(_tab == "settings")" @onclick='() => SelectTab("settings")'>Settings</button>
    </div>

    <div class="te-notice" aria-live="polite">@_notice</div>

    @if (_pendingConflict.IsOpen)
    {
        <ConflictNotice Busy="@_pendingBusy"
                        OnDiscard="DiscardPendingConflict"
                        OnReapply="ReapplyPendingConflictAsync">
            <LatestSummary>
                Timeline now has @_pendingConflict.Latest?.Revisions.Count revisions.
                Your pending @_pendingConflictLabel input is kept — review the timeline and choose how to proceed.
            </LatestSummary>
        </ConflictNotice>
    }

    @if (_refreshFaulted)
    {
        <div class="te-alert te-warn" role="status">
            @RefreshFailureText
            <button type="button" @onclick="ReloadAllAsync">Refresh now</button>
            @if (_refreshError?.IsUnauthorized == true)
            {
                <a href="@SignInUrl">Sign in again</a>
            }
        </div>
    }

    @if (_tab == "current")
    {
        <CurrentRevisionPanel Applicable="@_applicable"
                              Error="@_applicableError"
                              CoverageOrigin="@_timeline?.CoverageOrigin"
                              InstrumentId="@Id"
                              SignInUrl="@SignInUrl"
                              OnRetry="ReloadAllAsync"
                              OnOpenDrafts='() => SelectTab("drafts")' />
    }

    @if (_tab == "drafts")
    {
        <DraftListPanel Drafts="@_drafts"
                        Error="@_draftsError"
                        InstrumentId="@Id"
                        FocusId="@_focusId"
                        SignInUrl="@SignInUrl"
                        OnRetry="ReloadAllAsync"
                        OnApply="BeginApply"
                        OnSchedule="BeginSchedule"
                        OnDelete="BeginDeleteDraft">
            <PendingActionPanel Action="@_pending"
                                Busy="@_pendingBusy"
                                Error="@_pendingError"
                                Timeline="@_timeline"
                                OnConfirm="ConfirmPendingAsync"
                                OnCancel="CancelPendingAsync"
                                OnInputChanged="OnPendingInputChanged" />
        </DraftListPanel>
    }

    @if (_tab == "timeline")
    {
        <TimelinePanel Timeline="@_timeline"
                       Error="@_timelineError"
                       InstrumentId="@Id"
                       FocusId="@_focusId"
                       SignInUrl="@SignInUrl"
                       OnRetry="ReloadAllAsync"
                       OnRemove="BeginRemoveRevision">
            <PendingActionPanel Action="@_pending"
                                Busy="@_pendingBusy"
                                Error="@_pendingError"
                                Timeline="@_timeline"
                                OnConfirm="ConfirmPendingAsync"
                                OnCancel="CancelPendingAsync"
                                OnInputChanged="OnPendingInputChanged" />
        </TimelinePanel>
    }

    @if (_tab == "settings")
    {
        <InstrumentSettingsEditor Settings="@_settings"
                                  SignInUrl="@SignInUrl"
                                  Cancellation="@_lifetime.Token"
                                  OnSaved="OnSettingsSaved"
                                  OnNotice="SetNotice" />
    }
}

<DirtyGuard IsDirty="@(() => _pending?.HasInput == true)" />

@code {
    private WatchedInstrumentSettingsResponse? _settings;
    private MonitoringRuleTimelineResponse? _timeline;
    private MonitoringRuleDraftsResponse? _drafts;
    private MonitoringRuleRevisionDto? _applicable;
    private ApiError? _fatal;
    private ApiError? _applicableError;
    private ApiError? _draftsError;
    private ApiError? _timelineError;
    private string _tab = "current";
    private string? _notice;
    private PendingAction? _pending;
    private bool _pendingBusy;
    private ApiError? _pendingError;
    private readonly ConflictResolution<MonitoringRuleTimelineResponse> _pendingConflict = new();
    private DateTimeOffset? _nextBoundary;
    private Guid _loadedId;
    private int _loadGeneration;
    private CancellationTokenSource? _loadCts;
    private bool _refreshLoopStarted;
    private bool _refreshFaulted;
    private ApiError? _refreshError;
    private bool _headingFocusPending;
    private bool _revisionFocusPending;
    private Guid? _focusId;
    private PendingActionKind? _lastPendingKind;
    private readonly CancellationTokenSource _lifetime = new();

    internal TimeSpan RefreshInterval { get; set; } = TimeSpan.FromSeconds(20);

    internal PendingAction? ActivePending => _pending;

    internal bool RefreshFaulted => _refreshFaulted;

    internal DateTimeOffset? NextBoundary => _nextBoundary;

    internal string? Notice => _notice;

    internal Guid? FocusId => _focusId;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "focus")]
    public Guid? FocusQuery { get; set; }

    private string SignInUrl => AuthLinks.SignInUrl(Navigation);

    private string _pendingConflictLabel => _pending?.Kind switch
    {
        PendingActionKind.Apply => "apply",
        PendingActionKind.Schedule => "schedule",
        PendingActionKind.DeleteDraft => "delete",
        _ => "remove"
    };

    private string RefreshFailureText
    {
        get
        {
            if (_refreshError is null)
            {
                return "Background refresh paused after an unexpected error.";
            }

            if (_refreshError.IsUnauthorized)
            {
                return "Background refresh failed — your session may have expired. Your current input is kept.";
            }

            if (_refreshError.IsNotFound)
            {
                return "Background refresh failed — this instrument no longer exists or was deleted. Your current input is kept.";
            }

            return "Background refresh failed. Your current input is kept.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _tab = TabQuery is "drafts" or "timeline" or "settings" ? TabQuery : "current";
        if (FocusQuery is not null && FocusQuery.Value != _focusId)
        {
            _focusId = FocusQuery.Value;
            _revisionFocusPending = true;
        }

        if (Id != _loadedId)
        {
            _loadedId = Id;
            _settings = null;
            _timeline = null;
            _drafts = null;
            _applicable = null;
            _fatal = null;
            _applicableError = null;
            _draftsError = null;
            _timelineError = null;
            _pending = null;
            _pendingError = null;
            _pendingConflict.Take();
            _notice = null;
            _nextBoundary = null;
            _refreshError = null;
            _refreshFaulted = false;
            await ReloadAllAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_headingFocusPending && _settings is not null && _fatal is null)
        {
            _headingFocusPending = false;
            await JS.InvokeVoidAsync("teFocus", "h2");
        }

        if (_revisionFocusPending && _fatal is null && FocusTargetIsRendered())
        {
            _revisionFocusPending = false;
            string selector = _tab == "drafts" || _tab == "timeline"
                ? $"#revision-{_focusId}"
                : "h2";
            await JS.InvokeVoidAsync("teFocus", selector);
        }
    }

    private bool FocusTargetIsRendered()
    {
        if (_focusId is null)
        {
            return false;
        }

        return _tab switch
        {
            "drafts" => _drafts?.Drafts.Any(draft => draft.Id == _focusId) == true,
            "timeline" => _timeline?.Revisions.Any(revision => revision.Id == _focusId) == true,
            _ => _settings is not null,
        };
    }

    private async Task ReloadAllAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        int generation = ++_loadGeneration;
        CancellationToken cancellation = _loadCts.Token;


        _fatal = null;
        _headingFocusPending = _settings is null;

        try
        {
            ApiResult<WatchedInstrumentSettingsResponse> settings =
                await Api.GetSettingsAsync(Id, cancellation);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (settings.IsFailure)
            {
                if (_settings is null)
                {
                    _fatal = settings.Error!.IsNotFound
                        ? ApiError.Create(404, "instrument.not_found",
                            "This instrument does not exist or was removed.", null)
                        : settings.Error;
                    return;
                }

                _refreshError = settings.Error!.IsNotFound
                    ? ApiError.Create(404, "instrument.not_found",
                        "This instrument does not exist or was removed.", null)
                    : settings.Error;
                _refreshFaulted = true;
                return;
            }

            _settings = settings.Value;
            _refreshError = null;
            _refreshFaulted = false;

            Task<ApiResult<MonitoringRuleTimelineResponse>> timelineTask =
                Api.GetTimelineAsync(Id, cancellation);
            Task<ApiResult<MonitoringRuleDraftsResponse>> draftsTask =
                Api.GetDraftsAsync(Id, cancellation);
            Task<ApiResult<MonitoringRuleRevisionResponse>> applicableTask =
                Api.GetApplicableRevisionAsync(Id, cancellation);

            await Task.WhenAll(timelineTask, draftsTask, applicableTask);
            if (generation != _loadGeneration)
            {
                return;
            }

            ApplyReadModel(timelineTask.Result, draftsTask.Result, applicableTask.Result);
            _nextBoundary = ComputeNextBoundary();

            EnsureRefreshLoop();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ApplyReadModel(
        ApiResult<MonitoringRuleTimelineResponse> timeline,
        ApiResult<MonitoringRuleDraftsResponse> drafts,
        ApiResult<MonitoringRuleRevisionResponse> applicable)
    {
        _timeline = timeline.Value;
        _timelineError = timeline.Error;
        _drafts = drafts.Value;
        _draftsError = drafts.Error;

        _applicable = null;
        _applicableError = null;
        if (applicable.IsSuccess)
        {
            _applicable = applicable.Value!.Revision;
        }
        else if (applicable.Error!.IsNotFound is false)
        {
            _applicableError = applicable.Error;
        }
    }

    private void SelectTab(string tab)
    {
        if (tab != _tab)
        {
            Navigation.NavigateTo($"instruments/{Id}?tab={tab}", replace: true);
        }
    }

    private void SetNotice(string message)
    {
        _notice = message;
    }

    private void OnSettingsSaved(WatchedInstrumentSettingsResponse saved)
    {
        _settings = saved;
        _notice = "Settings saved.";
    }

    internal async Task BeginApply(MonitoringRuleRevisionDto draft)
    {
        if (_timeline is null)
        {
            _notice = "Timeline is still loading — try again shortly.";
            return;
        }

        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.Apply, draft, _timeline.ConcurrencyToken)
        {
            To = new UtcTimeField(draft.ProposedEffectiveTo)
        };
        _pendingError = null;
        _notice = null;
    }

    internal async Task BeginSchedule(MonitoringRuleRevisionDto draft)
    {
        if (_timeline is null)
        {
            _notice = "Timeline is still loading — try again shortly.";
            return;
        }

        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.Schedule, draft, _timeline.ConcurrencyToken)
        {
            From = new UtcTimeField(draft.ProposedEffectiveFrom),
            To = new UtcTimeField(draft.ProposedEffectiveTo)
        };
        _pendingError = null;
        _notice = null;
    }

    internal async Task BeginDeleteDraft(MonitoringRuleRevisionDto draft)
    {
        if (_timeline is null)
        {
            _notice = "Timeline is still loading — try again shortly.";
            return;
        }

        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.DeleteDraft, draft, _timeline.ConcurrencyToken);
        _pendingError = null;
        _notice = null;
    }

    internal async Task BeginRemoveRevision(MonitoringRuleRevisionDto revision)
    {
        if (_timeline is null)
        {
            _notice = "Timeline is still loading — try again shortly.";
            return;
        }

        if (await ConfirmDiscardPendingInputAsync() is false)
        {
            return;
        }

        _pending = new PendingAction(PendingActionKind.RemoveRevision, revision, _timeline.ConcurrencyToken);
        _pendingError = null;
        _notice = null;
    }

    private void OnPendingInputChanged()
    {
        StateHasChanged();
    }

    private async Task<bool> ConfirmDiscardPendingInputAsync()
    {
        if (_pending?.HasInput == true)
        {
            return await JS.InvokeAsync<bool>(
                "confirm",
                "Discard the times you entered for the current action?");
        }

        return true;
    }

    private async Task ConfirmPendingAsync()
    {
        if (_pending is null)
        {
            return;
        }

        ApiError? validationError = _pending.ResolveInputs(
            Clock.UtcNow, out string? effectiveFromIso, out string? effectiveToIso);
        if (validationError is not null)
        {
            _pendingError = validationError;
            return;
        }

        _lastPendingKind = _pending.Kind;
        _focusId = _pending.Revision.Id;
        _pendingBusy = true;
        _pendingError = null;
        _pendingConflict.Take();
        PendingAction action = _pending;
        ApiResult<MonitoringRuleTimelineResponse>? result = null;

        try
        {
            if (action.Kind == PendingActionKind.Apply)
            {
                result = await Api.ApplyDraftAsync(
                    Id,
                    action.Revision.Id,
                    new ApplyMonitoringRuleRequest(effectiveToIso),
                    action.CapturedToken,
                    _lifetime.Token);
            }
            else if (action.Kind == PendingActionKind.Schedule)
            {
                result = await Api.ScheduleDraftAsync(
                    Id,
                    action.Revision.Id,
                    new ScheduleMonitoringRuleRequest(effectiveFromIso, effectiveToIso),
                    action.CapturedToken,
                    _lifetime.Token);
            }
            else if (action.Kind == PendingActionKind.DeleteDraft)
            {
                result = await Api.DeleteDraftAsync(
                    Id, action.Revision.Id, action.CapturedToken, _lifetime.Token);
            }
            else
            {
                result = await Api.RemoveRevisionAsync(
                    Id, action.Revision.Id, action.CapturedToken, _lifetime.Token);
            }
        }
        finally
        {
            _pendingBusy = false;
        }

        if (result is null)
        {
            return;
        }

        if (result.IsSuccess)
        {
            _pending = null;
            await ReloadAllAsync();
            AnnounceMutationOutcome();
        }
        else if (result.Error!.IsPreconditionFailed)
        {
            await OpenPendingConflictAsync();
        }
        else
        {
            _pendingError = result.Error;
        }
    }

    private void AnnounceMutationOutcome()
    {
        if (_lastPendingKind is null)
        {
            _notice = "Timeline updated.";
            return;
        }

        if (_lastPendingKind == PendingActionKind.DeleteDraft)
        {
            _notice = "Draft deleted. No committed revision changed.";
            _focusId = null;
            _revisionFocusPending = false;
            return;
        }

        if (_lastPendingKind == PendingActionKind.RemoveRevision)
        {
            _notice = "Scheduled revision removed. The preceding revision now covers its period.";
            _focusId = null;
            _revisionFocusPending = false;
            return;
        }

        MonitoringRuleRevisionDto? committed = _timeline?.Revisions
            .SingleOrDefault(revision => revision.Id == _focusId);
        if (committed is null)
        {
            _notice = "Timeline updated. The committed revision is no longer visible in the latest timeline — review the Timeline tab.";
            _revisionFocusPending = false;
            return;
        }

        _revisionFocusPending = true;

        MonitoringRuleRevisionDto? predecessor = _timeline?.Revisions
            .SingleOrDefault(revision =>
                revision.Id != committed.Id
                && committed.EffectiveFrom is not null
                && revision.EffectiveTo == committed.EffectiveFrom);
        string predecessorText = predecessor is null
            ? "It is the earliest coverage period."
            : $"{RevisionLabels.RevisionTitle(predecessor)} now ends at its start ({UtcTimes.Format(predecessor.EffectiveTo)}).";
        string verb = _lastPendingKind == PendingActionKind.Apply ? "applied" : "scheduled";

        _notice = $"{RevisionLabels.RevisionTitle(committed)} {verb} — effective "
            + $"{UtcTimes.FormatRange(committed.EffectiveFrom, committed.EffectiveTo)}. "
            + predecessorText;
    }

    private async Task OpenPendingConflictAsync()
    {
        ApiResult<MonitoringRuleTimelineResponse> latest =
            await Api.GetTimelineAsync(Id, _lifetime.Token);
        if (latest.IsSuccess)
        {
            _timeline = latest.Value;
            _nextBoundary = ComputeNextBoundary();
            _pendingConflict.Open(latest.Value!);
        }
        else
        {
            _pendingError = latest.Error;
        }
    }

    private void DiscardPendingConflict()
    {
        _pendingConflict.Take();
        _pending = null;
        _pendingError = null;
        _notice = "Latest timeline loaded — the pending action was discarded.";
    }

    private async Task ReapplyPendingConflictAsync()
    {
        MonitoringRuleTimelineResponse latest = _pendingConflict.Take();
        if (_pending is not null)
        {
            _pending.CapturedToken = latest.ConcurrencyToken;
            await ConfirmPendingAsync();
        }
    }

    private async Task CancelPendingAsync()
    {
        if (_pending?.HasInput == true)
        {
            bool confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Discard the times you entered for this action?");
            if (confirmed is false)
            {
                return;
            }
        }

        _pending = null;
        _pendingError = null;
        _pendingConflict.Take();
    }

    private DateTimeOffset? ComputeNextBoundary()
    {
        DateTimeOffset? next = null;
        if (_timeline is null)
        {
            return null;
        }

        foreach (MonitoringRuleRevisionDto revision in _timeline.Revisions)
        {
            next = Earliest(next, revision.EffectiveFrom);
            next = Earliest(next, revision.EffectiveTo);
        }

        return next;
    }

    private DateTimeOffset? Earliest(DateTimeOffset? current, DateTimeOffset? candidate)
    {
        if (candidate is null || candidate.Value <= Clock.UtcNow)
        {
            return current;
        }

        return current is null || candidate < current ? candidate : current;
    }

    private void EnsureRefreshLoop()
    {
        if (_refreshLoopStarted)
        {
            return;
        }

        _refreshLoopStarted = true;
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            while (true)
            {
                await Task.Delay(RefreshInterval, _lifetime.Token);
                try
                {
                    if (_nextBoundary is not null && _nextBoundary.Value <= Clock.UtcNow)
                    {
                        _refreshFaulted = false;
                        await InvokeAsync(ReloadAllAsync);
                    }

                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException)
                {
                    throw;
                }
                catch (Exception)
                {
                    _refreshFaulted = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
